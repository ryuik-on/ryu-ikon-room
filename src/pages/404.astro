---
const base = import.meta.env.BASE_URL;
---

<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="dark" />
		<meta name="robots" content="noindex" />
		<title>ページが見つかりません｜ROOM</title>
		<link rel="icon" href={`${base}favicon.ico`} sizes="48x48" />
	</head>
	<body>
		<main>
			<p class="code">404</p>
			<h1>ページが見つかりません</h1>
			<p><a href={base}>ROOMのトップページへ戻る</a></p>
		</main>

		<style>
			body {
				margin: 0;
				min-height: 100svh;
				display: grid;
				place-items: center;
				background: #131313;
				color: #f2f2f0;
				font-family: -apple-system, BlinkMacSystemFont, "Hiragino Kaku Gothic ProN", "Hiragino Sans", "Noto Sans JP", "Yu Gothic", sans-serif;
				text-align: center;
			}
			.code {
				margin: 0;
				font-size: 0.85rem;
				letter-spacing: 0.3em;
				color: #8a8a86;
			}
			h1 {
				margin: 8px 0 24px;
				font-size: 1.2rem;
				font-weight: 600;
			}
			a {
				color: #f2f2f0;
			}
		</style>
	</body>
</html>
