---
import { Image } from "astro:assets";
import heroPhoto from "../assets/hero/hero-photo.jpg";
import heroLogo from "../assets/hero/ryuikon-logo.png";
import photo01 from "../assets/photos/photo-01.jpg";
import photo02 from "../assets/photos/photo-02.jpg";
import photo03 from "../assets/photos/photo-03.jpg";

// 素材はすべて部内撮影・使用可確認済み（facts-and-content.md参照）
const photos = [
  { src: photo01, alt: "マイクに向かって手を伸ばすボーカルと、それに応える観客たち" },
  { src: photo02, alt: "後ろ姿でステージに立つボーカルと、向き合う演奏者たち" },
  { src: photo03, alt: "両手を上げて盛り上がる観客と、それを見守る奏者" },
];

const eventInfo = {
  organizer: "琉球大学医学部軽音部（Ryuik-on）",
  date: "2026年11月22日（日）",
  open: "16:00",
  start: "17:00",
  endEstimate: "20:00頃",
  venue: "那覇市ぶんかテンブス館 テンブスホール",
};

const prices = [
  { label: "小人", price: "¥500", note: "小学生以下（未就学児を含む）が対象です" },
  { label: "学生", price: "¥1,000", note: "当日、学生証をご提示ください" },
  { label: "一般", price: "¥1,500", note: "通常料金" },
];

const ticketUrl = "https://teket.jp/19130/74082";
const saleStartISO = "2026-08-22T00:00:00+09:00";
const saleStartLabel = "2026年8月22日（土）";

const mapUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(eventInfo.venue)}`;

const siteUrl = "https://ryuik-on.github.io/ryu-ikon-room/";
const siteTitle = `ROOM｜${eventInfo.organizer}`;
const siteDescription =
  "2026年11月22日（日）、那覇市ぶんかテンブス館 テンブスホールにて開催。琉球大学医学部軽音部（Ryuik-on）によるワンマンライブ「ROOM」。OPEN 16:00 / START 17:00。";
const base = import.meta.env.BASE_URL;

// 解析ツール（GoatCounter）。アカウント未作成のため、コード発行後にここへ設定する。
const goatcounterCode = "";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "MusicEvent",
  name: "ROOM",
  url: siteUrl,
  image: `${siteUrl}ogp.png`,
  startDate: "2026-11-22T17:00:00+09:00",
  endDate: "2026-11-22T20:00:00+09:00",
  doorTime: "2026-11-22T16:00:00+09:00",
  eventStatus: "https://schema.org/EventScheduled",
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  location: {
    "@type": "Place",
    name: eventInfo.venue,
    address: "沖縄県那覇市牧志3-2-10 てんぶす那覇4階",
  },
  organizer: {
    "@type": "Organization",
    name: eventInfo.organizer,
    url: "https://ryuik-on.github.io/ryuik-on-official",
  },
  offers: [
    { "@type": "Offer", name: "一般", price: "1500", priceCurrency: "JPY", url: ticketUrl, availability: "https://schema.org/InStock", validFrom: saleStartISO },
    { "@type": "Offer", name: "学生", price: "1000", priceCurrency: "JPY", url: ticketUrl, availability: "https://schema.org/InStock", validFrom: saleStartISO },
    { "@type": "Offer", name: "小人", price: "500", priceCurrency: "JPY", url: ticketUrl, availability: "https://schema.org/InStock", validFrom: saleStartISO },
  ],
};
---

<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="dark" />
		<meta name="theme-color" content="#080808" />
		<title>{siteTitle}</title>
		<meta name="description" content={siteDescription} />
		<link rel="canonical" href={siteUrl} />
		<link rel="icon" href={`${base}favicon.ico`} sizes="48x48" />
		<link rel="icon" href={`${base}favicon-192.png`} type="image/png" sizes="192x192" />
		<link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={siteTitle} />
		<meta property="og:title" content={siteTitle} />
		<meta property="og:description" content={siteDescription} />
		<meta property="og:url" content={siteUrl} />
		<meta property="og:image" content={`${siteUrl}ogp.png`} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:locale" content="ja_JP" />
		<meta name="twitter:card" content="summary_large_image" />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
		{goatcounterCode && (
			<script is:inline data-goatcounter={`https://${goatcounterCode}.goatcounter.com/count`} async src="https://gc.zgo.at/count.js"></script>
		)}
	</head>
	<body>
		<a class="skip-link" href="#content">本文へ移動</a>

		<header class="site-header" aria-label="メインナビゲーション">
			<a class="brand" href="#top" aria-label="ROOM トップへ">ROOM</a>
			<nav>
				<a href="#about">公演について</a>
				<a href="#information">開催情報</a>
				<a class="ticket-link header-ticket" href="#tickets"><span>購入</span><span aria-hidden="true">↗</span></a>
			</nav>
		</header>

		<main id="content">
			<section class="hero" id="top" aria-labelledby="hero-title">
				<div class="hero-aperture" aria-hidden="true">
					<Image src={heroPhoto} alt="" class="hero-aperture-photo" widths={[480, 900, 1400]} sizes="47vw" loading="eager" fetchpriority="high" />
					<div class="aperture-line"></div>
				</div>
				<div class="hero-kicker">
					<span>Ryuik-on presents</span>
					<span>LIVE 2026</span>
				</div>
				<div class="hero-main">
					<h1 id="hero-title">ROOM</h1>
					<p>一つの公演を、本気でつくる。</p>
				</div>
				<div class="hero-meta">
					<div>
						<span class="meta-label">DATE</span>
						<strong>2026.11.22</strong>
						<span>SUN</span>
					</div>
					<div>
						<span class="meta-label">TIME</span>
						<strong>OPEN {eventInfo.open}</strong>
						<span>START {eventInfo.start}</span>
					</div>
					<div>
						<span class="meta-label">PLACE</span>
						<strong>那覇市ぶんかテンブス館</strong>
						<span>テンブスホール</span>
					</div>
					<a class="ticket-link" href="#tickets"><span>チケットを購入する</span><span aria-hidden="true">↗</span></a>
				</div>
				<a class="scroll-cue" href="#about">
					<span>SCROLL</span>
					<i aria-hidden="true"></i>
				</a>
			</section>

			<section class="statement section-pad" id="about" aria-labelledby="about-title">
				<div class="section-index reveal">01 / ABOUT</div>
				<div class="statement-copy reveal">
					<h2 id="about-title">見せたいのは、<br />完成した音だけではない。</h2>
					<p>
						試し、崩し、もう一度合わせる。その繰り返しの先に、一度きりの演奏があります。
						ROOMは、{eventInfo.organizer}が、一つの公演をつくり上げるライブです。
					</p>
				</div>
			</section>

			<section class="process section-pad" aria-labelledby="process-title">
				<div class="section-heading reveal">
					<div class="section-index">02 / PROCESS</div>
					<h2 id="process-title">音が立ち上がるまで。</h2>
				</div>
				<div class="process-grid">
					<article class="process-card process-card-large reveal">
						<div class="process-visual"><span>01</span><i></i></div>
						<div>
							<h3>合わせる。</h3>
							<p>一人の演奏ではなく、一つの音になるまで。聴き、止まり、また始める。</p>
						</div>
					</article>
					<article class="process-card reveal">
						<div class="process-visual"><span>02</span><i></i></div>
						<div>
							<h3>聴き直す。</h3>
							<p>演奏する側ではなく、客席に届く音として確かめる。</p>
						</div>
					</article>
					<article class="process-card reveal">
						<div class="process-visual"><span>03</span><i></i></div>
						<div>
							<h3>組み直す。</h3>
							<p>曲だけでなく、順番、間、光まで。一夜の流れを設計する。</p>
						</div>
					</article>
				</div>
			</section>

			<section class="scene section-pad" aria-labelledby="scene-title">
				<div class="section-heading reveal">
					<div class="section-index">03 / SCENE</div>
					<h2 id="scene-title">その場に、音がある。</h2>
				</div>
				<ul class="scene-grid">
					{photos.map((photo, i) => (
						<li class="scene-frame reveal">
							<span class="scene-number">{String(i + 1).padStart(2, "0")}</span>
							<Image src={photo.src} alt={photo.alt} widths={[420, 700, 960]} sizes="(min-width: 800px) 31vw, 92vw" loading="eager" />
						</li>
					))}
				</ul>
				<p class="scene-copy reveal">
					音を鳴らしている姿。<br />
					その姿から伝わる熱は、<br />
					必要としている誰かに届くはずです。
				</p>
			</section>

			<section class="invitation section-pad" aria-labelledby="founder-title">
				<div class="invitation-rule reveal" aria-hidden="true"><span></span></div>
				<div class="invitation-copy reveal">
					<div class="section-index">04 / FOUNDER'S NOTE</div>
					<h2 id="founder-title">だから、この夜をつくります。</h2>
					<p>
						鳴らした音を、届くべき人へ。<br />
						それを目の当たりにすれば、自分だけじゃないと思えるかもしれません。
					</p>
				</div>
			</section>

			<section class="information section-pad" id="information" aria-labelledby="info-title">
				<div class="section-heading reveal">
					<div class="section-index">05 / INFORMATION</div>
					<h2 id="info-title">その夜の情報。</h2>
				</div>
				<div class="info-board reveal">
					<div class="date-block">
						<span>2026</span>
						<strong>11.22</strong>
						<em>SUN</em>
					</div>
					<dl>
						<div>
							<dt>OPEN</dt>
							<dd>{eventInfo.open}</dd>
						</div>
						<div>
							<dt>START</dt>
							<dd>{eventInfo.start}</dd>
						</div>
						<div>
							<dt>終演目安</dt>
							<dd>{eventInfo.endEstimate}</dd>
						</div>
						<div>
							<dt>VENUE</dt>
							<dd>
								{eventInfo.venue}
								<small>テンブスホール</small>
							</dd>
						</div>
						<div>
							<dt>HOST</dt>
							<dd>
								{eventInfo.organizer}
							</dd>
						</div>
					</dl>
				</div>
			</section>

			<section class="tickets section-pad" id="tickets" aria-labelledby="ticket-title">
				<div class="section-heading reveal">
					<div class="section-index">06 / TICKET</div>
					<h2 id="ticket-title">チケット。</h2>
				</div>
				<div class="price-list reveal">
					{prices.map((item) => (
						<div class="price-row">
							<span>{item.label}</span>
							<strong>{item.price}</strong>
							<small>{item.note}</small>
						</div>
					))}
				</div>
				<div class="ticket-action reveal">
					<a
						class="ticket-link ticket-cta is-pending"
						href={ticketUrl}
						target="_blank"
						rel="noopener"
						data-ticket-cta
						data-sale-start={saleStartISO}
						aria-disabled="true"
					>
						<span data-ticket-label>販売開始までお待ちください</span>
						<span aria-hidden="true">↗</span>
					</a>
					<p>
						前売券は{saleStartLabel}販売開始。teket（外部サイト）での販売です。<br />
						当日券は前売りの残数がある場合のみ販売します。
					</p>
				</div>
				<div class="ticket-faq reveal">
					<details>
						<summary>小人・学生料金の対象について<span aria-hidden="true">+</span></summary>
						<p>小人は小学生以下（未就学児を含む）が対象です。学生は当日、学生証をご提示ください。</p>
					</details>
					<details>
						<summary>当日券について<span aria-hidden="true">+</span></summary>
						<p>当日券は、前売り券に残数がある場合のみ販売します。</p>
					</details>
					<details>
						<summary>初めてRyuik-onを見る方へ<span aria-hidden="true">+</span></summary>
						<p>どなたにも一つのライブとして楽しんでいただける公演を目指しています。</p>
					</details>
				</div>
			</section>

			<section class="venue section-pad" aria-labelledby="venue-title">
				<div class="section-heading reveal">
					<div class="section-index">07 / VENUE</div>
					<h2 id="venue-title">会場へ。</h2>
				</div>
				<div class="venue-grid reveal">
					<div class="venue-map" aria-hidden="true">
						<span class="map-line map-line-one"></span>
						<span class="map-line map-line-two"></span>
						<span class="map-line map-line-three"></span>
						<i></i>
						<b>ROOM</b>
					</div>
					<div class="venue-copy">
						<h3>{eventInfo.venue}</h3>
						<p>〒900-0013 沖縄県那覇市牧志3-2-10 てんぶす那覇4階</p>
						<p>ゆいレール牧志駅から徒歩約5分（有料駐車場81台あり）</p>
						<a class="text-link" href={mapUrl} target="_blank" rel="noopener">地図を開く <span aria-hidden="true">↗</span></a>
					</div>
				</div>
			</section>

			<section class="final-cta" aria-labelledby="final-title">
				<div class="final-aperture" aria-hidden="true">
					<Image src={heroPhoto} alt="" class="final-aperture-photo" widths={[600, 1000, 1600]} sizes="100vw" loading="eager" />
				</div>
				<div class="final-inner reveal">
					<span>Ryuik-on presents</span>
					<h2 id="final-title">11月22日、ROOMで。</h2>
					<p>
						OPEN {eventInfo.open} / START {eventInfo.start}<br />
						{eventInfo.venue}
					</p>
					<a class="ticket-link" href="#tickets"><span>チケットを購入する</span><span aria-hidden="true">↗</span></a>
				</div>
			</section>
		</main>

		<footer>
			<div class="footer-brand">
				<a class="footer-room" href="#top">ROOM</a>
				<p>{eventInfo.organizer}</p>
			</div>
			<div class="footer-links">
				<a href="https://www.instagram.com/ryuikeion/" target="_blank" rel="noopener">
					Instagram
					<small>最新情報の発信・お問い合わせはDMへ</small>
				</a>
				<a href="https://ryuik-on.github.io/ryuik-on-official" target="_blank" rel="noopener">
					公式サイト
					<small>琉球大学医学部を拠点に活動する軽音部、Ryuik-onについて</small>
				</a>
			</div>
			<p class="copyright">&copy; 2026 {eventInfo.organizer}</p>
		</footer>

		<div class="mobile-ticket-bar" data-mobile-ticket-bar>
			<div>
				<strong>11.22 SUN</strong>
				<span>一般 ¥1,500</span>
			</div>
			<a class="ticket-link" href="#tickets"><span>購入する</span><span aria-hidden="true">↗</span></a>
		</div>

		<script define:vars={{ saleStartISO }}>
			const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
			const root = document.documentElement;
			const ticketSection = document.querySelector("#tickets");
			const mobileBar = document.querySelector("[data-mobile-ticket-bar]");

			const onScroll = () => {
				const progress = Math.min(1, Math.max(0, window.scrollY / (window.innerHeight * 0.72)));
				root.style.setProperty("--room-open", progress.toFixed(3));

				const rect = ticketSection?.getBoundingClientRect();
				const ticketVisible = rect ? rect.top < window.innerHeight * 0.85 && rect.bottom > 100 : false;
				mobileBar?.classList.toggle("is-active", window.scrollY > window.innerHeight * 0.72 && !ticketVisible);
			};

			if (!reduceMotion) {
				window.addEventListener("scroll", onScroll, { passive: true });
				onScroll();
			} else {
				root.style.setProperty("--room-open", "1");
			}

			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							entry.target.classList.add("is-visible");
							observer.unobserve(entry.target);
						}
					});
				},
				{ threshold: 0.14 },
			);
			document.querySelectorAll(".reveal").forEach((node) => observer.observe(node));

			// 販売開始日の自動切り替え：8/22まではボタンを無効表示し、以降は実リンクを有効化する
			const saleStart = new Date(saleStartISO);
			const onSale = new Date() >= saleStart;
			document.querySelectorAll("[data-ticket-cta]").forEach((el) => {
				if (onSale) {
					el.classList.remove("is-pending");
					el.removeAttribute("aria-disabled");
					const label = el.querySelector("[data-ticket-label]");
					if (label) label.textContent = "チケットを購入する";
				} else {
					el.addEventListener("click", (e) => e.preventDefault());
				}
			});
		</script>

		<style is:global>
			@font-face {
				font-family: "Archivo Variable";
				src: url("/ryu-ikon-room/fonts/archivo-variable-latin.woff2") format("woff2-variations"),
					url("/ryu-ikon-room/fonts/archivo-variable-latin.woff2") format("woff2");
				font-weight: 100 900;
				font-stretch: 62% 125%;
				font-style: normal;
				font-display: swap;
			}

			:root {
				color-scheme: dark;
				--ink: #080808;
				--soft-black: #111111;
				--warm-white: #f1efe9;
				--ash: #aaa7a0;
				--vermilion: #a94738;
				--hairline: #2a2927;
				--room-open: 0;
			}

			* {
				box-sizing: border-box;
			}

			html {
				scroll-behavior: smooth;
				background: var(--ink);
			}

			body {
				margin: 0;
				background: var(--ink);
				color: var(--warm-white);
				font-family: "Archivo Variable", "Hiragino Kaku Gothic ProN", "Hiragino Sans", "Noto Sans JP", "Yu Gothic", sans-serif;
				font-weight: 400;
				letter-spacing: 0.01em;
				-webkit-font-smoothing: antialiased;
			}

			a {
				color: inherit;
				text-decoration: none;
			}

			button,
			a {
				-webkit-tap-highlight-color: transparent;
			}

			a:focus-visible,
			summary:focus-visible {
				outline: 2px solid var(--vermilion);
				outline-offset: 4px;
			}

			main {
				overflow: clip;
			}

			.skip-link {
				position: absolute;
				left: -9999px;
				top: 0;
				z-index: 100;
				background: var(--vermilion);
				color: var(--warm-white);
				padding: 10px 18px;
			}
			.skip-link:focus {
				left: 0;
			}

			/* ---- Header ---- */
			.site-header {
				position: fixed;
				top: 0;
				left: 0;
				z-index: 30;
				display: flex;
				width: 100%;
				height: 76px;
				align-items: center;
				justify-content: space-between;
				padding: 0 3.25vw;
				mix-blend-mode: difference;
			}
			.brand,
			.footer-room {
				font-family: "Archivo Variable", sans-serif;
				font-size: 17px;
				font-weight: 600;
				letter-spacing: 0.22em;
			}
			.site-header nav {
				display: flex;
				align-items: center;
				gap: 34px;
				font-size: 12px;
			}
			.site-header nav > a:not(.ticket-link) {
				color: #e5e2db;
			}

			.ticket-link {
				display: inline-flex;
				min-height: 52px;
				min-width: 220px;
				align-items: center;
				justify-content: space-between;
				gap: 28px;
				border: 1px solid var(--warm-white);
				border-radius: 2px;
				background: var(--warm-white);
				color: var(--ink);
				padding: 0 20px;
				font-size: 14px;
				font-weight: 500;
				transition: color 180ms ease, background 180ms ease, opacity 180ms ease;
			}
			.ticket-link > span:last-child {
				transition: transform 180ms ease;
			}
			.ticket-link:hover {
				background: transparent;
				color: var(--warm-white);
			}
			.ticket-link:hover > span:last-child {
				transform: translate(3px, -3px);
			}
			.ticket-link.is-pending {
				opacity: 0.55;
				cursor: not-allowed;
			}
			.ticket-link.is-pending:hover {
				background: var(--warm-white);
				color: var(--ink);
			}
			.ticket-link.is-pending:hover > span:last-child {
				transform: none;
			}

			.site-header .header-ticket {
				min-height: 38px;
				min-width: 116px;
				padding-inline: 16px;
				mix-blend-mode: normal;
			}

			/* ---- Hero ---- */
			.hero {
				position: relative;
				min-height: 100svh;
				padding: 100px 3.25vw 42px;
				border-bottom: 1px solid var(--hairline);
				isolation: isolate;
			}
			.hero-aperture {
				position: absolute;
				top: 0;
				left: 56%;
				z-index: -1;
				width: calc(5px + var(--room-open) * min(47vw, 720px));
				height: 100%;
				min-width: 5px;
				overflow: hidden;
				background: var(--warm-white);
				transform: translateX(-50%);
				transition: width 80ms linear;
			}
			.hero-aperture .hero-aperture-photo {
				position: absolute;
				inset: 0;
				width: min(47vw, 720px);
				max-width: none;
				height: 100%;
				object-fit: cover;
				object-position: 40% 30%;
				filter: grayscale(1) contrast(1.05) brightness(1.08);
				opacity: 0.32;
				mix-blend-mode: multiply;
			}
			.aperture-line {
				position: absolute;
				top: 0;
				left: 50%;
				width: 1px;
				height: 100%;
				background: rgba(8, 8, 8, 0.22);
			}

			.hero-kicker {
				display: flex;
				justify-content: space-between;
				font-size: 10px;
				letter-spacing: 0.18em;
				text-transform: uppercase;
			}
			.hero-main {
				position: absolute;
				top: 46%;
				left: 3.25vw;
				transform: translateY(-50%);
			}
			.hero-main h1 {
				margin: 0 0 18px;
				font-family: "Archivo Variable", sans-serif;
				font-size: clamp(88px, 15.5vw, 244px);
				font-stretch: 62%;
				font-weight: 300;
				letter-spacing: -0.02em;
				line-height: 0.75;
			}
			.hero-main p {
				margin: 0 0 0 0.6vw;
				font-size: clamp(21px, 2vw, 32px);
				font-weight: 400;
				letter-spacing: 0.06em;
			}
			.hero-meta {
				position: absolute;
				right: 3.25vw;
				bottom: 42px;
				left: 3.25vw;
				display: grid;
				grid-template-columns: 1.15fr 1.15fr 1.8fr auto;
				gap: 22px;
				align-items: end;
			}
			.hero-meta > div {
				display: grid;
				min-height: 76px;
				align-content: start;
				border-top: 1px solid currentColor;
				padding-top: 10px;
			}
			.hero-meta strong,
			.hero-meta span {
				font-size: 12px;
				font-style: normal;
				line-height: 1.6;
			}
			.hero-meta .meta-label {
				margin-bottom: 8px;
				color: var(--ash);
				font-size: 9px;
				letter-spacing: 0.16em;
			}

			.scroll-cue {
				position: absolute;
				right: 3.25vw;
				top: 40%;
				display: flex;
				align-items: center;
				gap: 12px;
				color: var(--ash);
				font-size: 9px;
				letter-spacing: 0.14em;
				transform: rotate(90deg);
				transform-origin: right center;
			}
			.scroll-cue i {
				display: block;
				width: 42px;
				height: 1px;
				background: currentColor;
			}

			/* ---- 共通セクション ---- */
			.section-pad {
				padding: 180px 6.5vw;
			}
			.section-index {
				color: var(--ash);
				font-size: 10px;
				letter-spacing: 0.18em;
				font-variant-numeric: tabular-nums;
			}

			.statement {
				display: grid;
				min-height: 94svh;
				grid-template-columns: 3fr 9fr;
				align-items: start;
			}
			.statement-copy {
				max-width: 1000px;
			}
			.statement h2,
			.section-heading h2,
			.invitation h2,
			.final-cta h2 {
				margin: 0;
				font-family: "Archivo Variable", sans-serif;
				font-size: clamp(42px, 5.6vw, 84px);
				font-stretch: 88%;
				font-weight: 300;
				letter-spacing: -0.01em;
				line-height: 1.26;
			}
			.statement p,
			.invitation p {
				max-width: 630px;
				margin: 72px 0 0 auto;
				color: var(--ash);
				font-size: clamp(16px, 1.3vw, 19px);
				line-height: 2.05;
			}

			.section-heading {
				display: grid;
				grid-template-columns: 3fr 9fr;
				align-items: start;
				margin-bottom: 96px;
			}

			/* C: セクション番号をデスクトップでsticky化 */
			@media (min-width: 900px) {
				.statement > .section-index,
				.section-heading > .section-index {
					position: sticky;
					top: 100px;
					align-self: start;
				}
			}

			/* ---- PROCESS ---- */
			.process {
				border-top: 1px solid var(--hairline);
			}
			.process-grid {
				display: grid;
				grid-template-columns: 1.4fr 1fr;
				gap: 1px;
				background: var(--hairline);
				border: 1px solid var(--hairline);
			}
			.process-card {
				display: grid;
				min-height: 390px;
				grid-template-rows: 1fr auto;
				gap: 64px;
				background: var(--ink);
				padding: 30px;
			}
			.process-card-large {
				grid-row: span 2;
				min-height: 780px;
			}
			.process-visual {
				position: relative;
				overflow: hidden;
				background: var(--soft-black);
			}
			.process-visual::after {
				position: absolute;
				top: 0;
				left: 50%;
				width: 1px;
				height: 100%;
				background: var(--hairline);
				content: "";
			}
			.process-card-large .process-visual::before {
				position: absolute;
				top: 50%;
				left: 0;
				width: 100%;
				height: 1px;
				background: var(--hairline);
				content: "";
			}
			.process-visual span {
				position: absolute;
				top: 18px;
				left: 18px;
				z-index: 1;
				color: var(--ash);
				font-size: 10px;
				letter-spacing: 0.12em;
				font-variant-numeric: tabular-nums;
			}
			.process-visual i {
				position: absolute;
				top: 50%;
				left: 50%;
				z-index: 1;
				width: 6px;
				height: 6px;
				border-radius: 50%;
				background: var(--vermilion);
				transform: translate(-50%, -50%);
			}
			.process-card h3 {
				margin: 0 0 14px;
				font-size: 25px;
				font-weight: 400;
			}
			.process-card p {
				max-width: 480px;
				margin: 0;
				color: var(--ash);
				font-size: 14px;
				line-height: 1.85;
			}

			/* ---- A: SCENE（写真を罫線システムに組み込む） ---- */
			.scene {
				border-top: 1px solid var(--hairline);
			}
			.scene-grid {
				list-style: none;
				margin: 0 0 96px;
				padding: 0;
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1px;
				background: var(--hairline);
				border: 1px solid var(--hairline);
			}
			.scene-frame {
				position: relative;
				aspect-ratio: 4 / 3;
				overflow: hidden;
				background: var(--soft-black);
			}
			.scene-number {
				position: absolute;
				top: 14px;
				left: 14px;
				z-index: 1;
				color: var(--warm-white);
				font-size: 10px;
				letter-spacing: 0.12em;
				font-variant-numeric: tabular-nums;
				mix-blend-mode: difference;
			}
			.scene-frame img {
				display: block;
				width: 100%;
				height: 100%;
				object-fit: cover;
			}
			.scene-copy {
				max-width: 640px;
				margin: 0 0 0 auto;
				color: var(--ash);
				font-size: clamp(16px, 1.3vw, 19px);
				line-height: 2.1;
				text-align: right;
			}
			/* D: 試作。デスクトップのみ縦書き。 data-vertical-concept を付けた場合のみ有効 */
			@media (min-width: 900px) {
				[data-vertical-concept] .scene-copy {
					writing-mode: vertical-rl;
					text-orientation: mixed;
					max-width: none;
					height: 320px;
					margin: 0 0 0 auto;
					line-height: 2.4;
					text-align: left;
				}
			}

			/* ---- FOUNDER'S NOTE ---- */
			.invitation {
				display: grid;
				min-height: 88svh;
				grid-template-columns: 1fr 1fr;
				align-items: center;
			}
			.invitation-rule {
				position: relative;
				height: 56vh;
				max-height: 640px;
				border-left: 1px solid var(--hairline);
			}
			.invitation-rule::after {
				position: absolute;
				top: 50%;
				left: 0;
				width: 100%;
				height: 1px;
				background: var(--hairline);
				content: "";
			}
			.invitation-rule span {
				position: absolute;
				top: 50%;
				left: 0;
				z-index: 1;
				width: 9px;
				height: 9px;
				background: var(--vermilion);
				transform: translate(-50%, -50%);
			}
			.invitation-copy {
				padding-left: 8vw;
			}
			.invitation-copy .section-index {
				margin-bottom: 42px;
			}
			.invitation h2 {
				font-size: clamp(38px, 4.5vw, 68px);
			}
			.invitation p {
				margin: 52px 0 0;
			}

			/* ---- INFORMATION ---- */
			.information {
				background: var(--warm-white);
				color: var(--ink);
			}
			.information .section-index {
				color: #6c6962;
			}
			.info-board {
				display: grid;
				grid-template-columns: 5fr 7fr;
				border-top: 1px solid #bdb9b1;
				border-bottom: 1px solid #bdb9b1;
			}
			.date-block {
				display: grid;
				align-content: space-between;
				min-height: 500px;
				border-right: 1px solid #bdb9b1;
				padding: 30px 36px 30px 0;
			}
			.date-block span,
			.date-block em {
				font-size: 12px;
				font-style: normal;
				letter-spacing: 0.14em;
			}
			.date-block strong {
				font-family: "Archivo Variable", sans-serif;
				font-size: clamp(90px, 10vw, 160px);
				font-stretch: 70%;
				font-weight: 300;
				letter-spacing: -0.02em;
				line-height: 0.85;
			}
			.info-board dl {
				margin: 0;
			}
			.info-board dl > div {
				display: grid;
				min-height: 108px;
				grid-template-columns: 1fr 2.5fr;
				align-items: start;
				border-bottom: 1px solid #bdb9b1;
				padding: 24px 0 18px 38px;
			}
			.info-board dl > div:last-child {
				border-bottom: 0;
			}
			.info-board dt {
				color: #6c6962;
				font-size: 10px;
				letter-spacing: 0.16em;
			}
			.info-board dd {
				margin: 0;
				font-size: clamp(18px, 1.7vw, 26px);
				font-weight: 400;
			}
			.info-board dd small {
				display: block;
				margin-top: 7px;
				color: #6c6962;
				font-size: 13px;
			}

			/* ---- TICKET ---- */
			.tickets {
				border-bottom: 1px solid var(--hairline);
			}
			.price-list {
				border-top: 1px solid var(--hairline);
			}
			.price-row {
				display: grid;
				min-height: 130px;
				grid-template-columns: 2fr 3fr 3fr;
				align-items: center;
				border-bottom: 1px solid var(--hairline);
			}
			.price-row > span {
				font-size: 18px;
			}
			.price-row strong {
				font-family: "Archivo Variable", sans-serif;
				font-size: clamp(42px, 5vw, 70px);
				font-stretch: 80%;
				font-weight: 300;
				letter-spacing: -0.01em;
				font-variant-numeric: tabular-nums;
			}
			.price-row small {
				color: var(--ash);
				font-size: 12px;
			}

			.ticket-action {
				display: grid;
				grid-template-columns: auto 1fr;
				gap: 40px;
				align-items: center;
				margin: 66px 0 100px;
			}
			.ticket-action p {
				max-width: 580px;
				margin: 0;
				color: var(--ash);
				font-size: 13px;
				line-height: 1.8;
			}

			.ticket-faq {
				margin-left: 25%;
				border-top: 1px solid var(--hairline);
			}
			.ticket-faq details {
				border-bottom: 1px solid var(--hairline);
			}
			.ticket-faq summary {
				display: flex;
				min-height: 70px;
				align-items: center;
				justify-content: space-between;
				cursor: pointer;
				font-size: 14px;
				list-style: none;
			}
			.ticket-faq summary::-webkit-details-marker {
				display: none;
			}
			.ticket-faq summary span {
				color: var(--ash);
				font-size: 19px;
			}
			.ticket-faq details[open] summary span {
				content: "−";
			}
			.ticket-faq details p {
				max-width: 600px;
				margin: 0 0 26px;
				color: var(--ash);
				font-size: 13px;
				line-height: 1.8;
			}

			/* ---- VENUE ---- */
			.venue-grid {
				display: grid;
				grid-template-columns: 7fr 5fr;
				gap: 7vw;
				align-items: center;
			}
			.venue-map {
				position: relative;
				min-height: 480px;
				overflow: hidden;
				border: 1px solid var(--hairline);
				background: var(--soft-black);
			}
			.map-line {
				position: absolute;
				display: block;
				height: 1px;
				background: #3c3a36;
				transform-origin: center;
			}
			.map-line-one {
				top: 36%;
				left: -8%;
				width: 116%;
				transform: rotate(-8deg);
			}
			.map-line-two {
				top: 62%;
				left: -8%;
				width: 116%;
				transform: rotate(11deg);
			}
			.map-line-three {
				top: 0;
				left: 58%;
				width: 100%;
				transform: rotate(84deg);
			}
			.venue-map i {
				position: absolute;
				top: 48%;
				left: 55%;
				width: 11px;
				height: 11px;
				border-radius: 50%;
				background: var(--vermilion);
				box-shadow: 0 0 0 8px rgba(169, 71, 56, 0.12);
			}
			.venue-map b {
				position: absolute;
				top: calc(48% + 22px);
				left: 55%;
				font-family: "Archivo Variable", sans-serif;
				font-size: 10px;
				font-weight: 500;
				letter-spacing: 0.12em;
			}
			.venue-copy h3 {
				margin: 0 0 8px;
				font-size: clamp(22px, 2.2vw, 34px);
				font-weight: 400;
				line-height: 1.4;
			}
			.venue-copy p {
				margin: 7px 0;
				color: var(--ash);
				font-size: 14px;
				line-height: 1.8;
			}
			.text-link {
				display: inline-flex;
				align-items: center;
				gap: 14px;
				margin-top: 40px;
				border-bottom: 1px solid var(--warm-white);
				padding-bottom: 7px;
				font-size: 13px;
			}

			/* ---- FINAL CTA（E: IMG_9599を敷く） ---- */
			.final-cta {
				position: relative;
				display: grid;
				min-height: 100svh;
				place-items: center;
				border-top: 1px solid var(--hairline);
				text-align: center;
				isolation: isolate;
			}
			.final-aperture {
				position: absolute;
				inset: 13% 8%;
				z-index: -1;
				overflow: hidden;
				background: var(--warm-white);
			}
			.final-aperture .final-aperture-photo {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				object-fit: cover;
				object-position: 50% 30%;
				filter: grayscale(1) contrast(1.05);
				opacity: 0.22;
				mix-blend-mode: multiply;
			}
			.final-inner {
				position: relative;
				color: var(--ink);
			}
			.final-inner > span {
				display: block;
				margin-bottom: 44px;
				font-size: 10px;
				letter-spacing: 0.16em;
				text-transform: uppercase;
			}
			.final-cta h2 {
				font-size: clamp(42px, 6vw, 92px);
			}
			.final-cta p {
				margin: 38px 0;
				font-size: 13px;
				line-height: 1.9;
			}
			.final-cta .ticket-link {
				margin: 0 auto;
				border-color: var(--ink);
				background: var(--ink);
				color: var(--warm-white);
			}
			.final-cta .ticket-link:hover {
				background: transparent;
				color: var(--ink);
			}

			/* ---- Footer ---- */
			footer {
				display: grid;
				grid-template-columns: 1fr auto;
				gap: 40px 60px;
				border-top: 1px solid var(--hairline);
				padding: 60px 3.25vw;
			}
			.footer-brand p {
				margin: 10px 0 0;
				color: var(--ash);
				font-size: 12px;
			}
			.footer-links {
				display: grid;
				gap: 20px;
				font-size: 13px;
			}
			.footer-links a {
				display: block;
			}
			.footer-links small {
				display: block;
				margin-top: 4px;
				color: var(--ash);
				font-size: 11px;
			}
			.copyright {
				grid-column: 1 / -1;
				margin: 0;
				color: var(--ash);
				font-size: 11px;
			}

			.mobile-ticket-bar {
				display: none;
			}

			.reveal {
				opacity: 0;
				transform: translateY(16px);
				transition: opacity 650ms cubic-bezier(0.22, 1, 0.36, 1), transform 650ms cubic-bezier(0.22, 1, 0.36, 1);
			}
			.reveal.is-visible {
				opacity: 1;
				transform: translateY(0);
			}

			@media (max-width: 800px) {
				.site-header {
					height: 62px;
					padding: 0 20px;
				}
				.site-header nav > a:not(.header-ticket) {
					display: none;
				}
				.site-header .header-ticket {
					min-width: 96px;
					min-height: 36px;
				}

				.hero {
					min-height: 100svh;
					padding: 80px 20px 28px;
				}
				.hero-aperture {
					left: auto;
					right: 22px;
					width: calc(4px + var(--room-open) * 48vw);
					transform: none;
				}
				.hero-aperture .hero-aperture-photo {
					width: 48vw;
				}
				.hero-kicker {
					max-width: 68vw;
				}
				.hero-main {
					top: 37%;
					left: 20px;
				}
				.hero-main h1 {
					margin-bottom: 24px;
					font-size: clamp(78px, 27vw, 120px);
				}
				.hero-main p {
					max-width: 85vw;
					margin: 0;
					font-size: 22px;
					line-height: 1.55;
				}
				.hero-meta {
					right: 20px;
					bottom: 26px;
					left: 20px;
					grid-template-columns: 1fr 1fr;
					gap: 18px 12px;
				}
				.hero-meta > div {
					min-height: 64px;
				}
				.hero-meta > div:nth-child(3) {
					grid-column: 1 / -1;
				}
				.hero-meta .ticket-link {
					width: 100%;
					grid-column: 1 / -1;
				}
				.scroll-cue {
					display: none;
				}

				.section-pad {
					padding: 108px 22px;
				}

				.statement {
					display: block;
					min-height: auto;
				}
				.statement .section-index,
				.section-heading .section-index {
					margin-bottom: 42px;
					position: static;
				}
				.statement h2,
				.section-heading h2,
				.invitation h2,
				.final-cta h2 {
					font-size: 38px;
				}
				.statement p,
				.invitation p {
					margin: 52px 0 0;
					font-size: 16px;
					line-height: 1.95;
				}
				.section-heading {
					display: block;
					margin-bottom: 62px;
				}

				.process-grid {
					display: block;
					background: transparent;
					border: 0;
				}
				.process-card,
				.process-card-large {
					min-height: 430px;
					margin-bottom: 1px;
					border: 1px solid var(--hairline);
					padding: 18px;
				}
				.process-card-large {
					min-height: 520px;
				}

				.scene-grid {
					grid-template-columns: 1fr;
				}
				.scene-copy {
					text-align: left;
					margin: 0;
				}

				.invitation {
					display: block;
					min-height: auto;
				}
				.invitation-rule {
					width: 100%;
					height: 180px;
					border-left: 0;
				}
				.invitation-rule::before {
					position: absolute;
					top: 0;
					left: 50%;
					width: 1px;
					height: 100%;
					background: var(--hairline);
					content: "";
				}
				.invitation-rule span {
					left: 50%;
				}
				.invitation-copy {
					padding: 70px 0 0;
				}

				.info-board {
					display: block;
				}
				.date-block {
