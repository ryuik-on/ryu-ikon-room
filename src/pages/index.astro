---
import { Image } from "astro:assets";
import heroPhoto from "../assets/hero/hero-photo.jpg";
import heroLogo from "../assets/hero/ryuikon-logo.png";
import photo01 from "../assets/photos/photo-01.jpg";
import photo02 from "../assets/photos/photo-02.jpg";
import photo03 from "../assets/photos/photo-03.jpg";

// 素材はすべて部内撮影・使用可確認済み（facts-and-content.md参照）
const photos = [
  { src: photo01, alt: "マイクに向かって手を伸ばすボーカルと、それに応える観客たち" },
  { src: photo02, alt: "後ろ姿でステージに立つボーカルと、向き合う演奏者たち" },
  { src: photo03, alt: "両手を上げて盛り上がる観客と、それを見守る奏者" },
];

const eventInfo = {
  organizer: "琉球大学医学部軽音部（Ryuik-on）",
  date: "2026年11月22日（日）",
  open: "16:00",
  start: "17:00",
  endEstimate: "20:00頃",
  venueName: "那覇市ぶんかテンブス館",
  venueHall: "テンブスホール",
};
const venueFull = `${eventInfo.venueName} ${eventInfo.venueHall}`;

const prices = [
  { label: "小人", price: "¥500", note: "小学生以下（未就学児を含む）が対象です" },
  { label: "学生", price: "¥1,000", note: "当日、学生証をご提示ください" },
  { label: "一般", price: "¥1,500", note: "学生・小人の区分に当てはまらない方が対象です" },
];

// teket URLは主催者が確定済みと明言（facts-and-content.md参照）。
// 販売開始（8/22）前はteket側ページが非公開のため、リンク自体は常に
// 埋め込みつつ、JSで aria-disabled + クリック無効化して誤って踏めないようにする。
const ticketUrl = "https://teket.jp/19130/74082";
const saleStartISO = "2026-08-22T00:00:00+09:00";
const saleStartLabel = "2026年8月22日（土）";

const mapUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(venueFull)}`;

const siteUrl = "https://ryuik-on.github.io/ryu-ikon-room/";
const siteTitle = `ROOM｜${eventInfo.organizer}`;
const siteDescription =
  "2026年11月22日（日）、那覇市ぶんかテンブス館 テンブスホールにて開催。琉球大学医学部軽音部（Ryuik-on）によるワンマンライブ「ROOM」。OPEN 16:00 / START 17:00。";
const base = import.meta.env.BASE_URL;

// 解析ツール（GoatCounter）。アカウント未作成のため、コード発行後にここへ設定する。
const goatcounterCode = "";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "MusicEvent",
  name: "ROOM",
  url: siteUrl,
  image: `${siteUrl}ogp.png`,
  startDate: "2026-11-22T17:00:00+09:00",
  endDate: "2026-11-22T20:00:00+09:00",
  doorTime: "2026-11-22T16:00:00+09:00",
  eventStatus: "https://schema.org/EventScheduled",
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  location: {
    "@type": "Place",
    name: venueFull,
    address: "沖縄県那覇市牧志3-2-10 てんぶす那覇4階",
  },
  organizer: {
    "@type": "Organization",
    name: eventInfo.organizer,
    url: "https://ryuik-on.github.io/ryuik-on-official",
  },
  offers: [
    { name: "一般", price: "1500" },
    { name: "学生", price: "1000" },
    { name: "小人", price: "500" },
  ].map((offer) => ({
    "@type": "Offer",
    ...offer,
    priceCurrency: "JPY",
    url: ticketUrl,
    availability: "https://schema.org/InStock",
    validFrom: saleStartISO,
  })),
};

const fontFaceCss = `@font-face{font-family:"Archivo Variable";src:url("${base}fonts/archivo-variable-latin.woff2") format("woff2-variations"),url("${base}fonts/archivo-variable-latin.woff2") format("woff2");font-weight:100 900;font-stretch:62% 125%;font-style:normal;font-display:swap;}`;
---

<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="dark" />
		<meta name="theme-color" content="#080808" />
		<title>{siteTitle}</title>
		<meta name="description" content={siteDescription} />
		{/* JSが動く環境にだけ .reveal の初期非表示を適用するためのフラグ（プログレッシブエンハンスメント） */}
		<script is:inline>document.documentElement.classList.add("js");</script>
		<Fragment set:html={`<style>${fontFaceCss}</style>`} />
		<link rel="canonical" href={siteUrl} />
		<link rel="icon" href={`${base}favicon.ico`} sizes="48x48" />
		<link rel="icon" href={`${base}favicon-192.png`} type="image/png" sizes="192x192" />
		<link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="ROOM" />
		<meta property="og:title" content={siteTitle} />
		<meta property="og:description" content={siteDescription} />
		<meta property="og:url" content={siteUrl} />
		<meta property="og:image" content={`${siteUrl}ogp.png`} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:locale" content="ja_JP" />
		<meta name="twitter:card" content="summary_large_image" />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
		{goatcounterCode && (
			<script is:inline data-goatcounter={`https://${goatcounterCode}.goatcounter.com/count`} async src="https://gc.zgo.at/count.js"></script>
		)}
	</head>
	<body>
		<a class="skip-link" href="#content">本文へ移動</a>

		{/* Hero扉が開く前に一瞬挟むロゴ単体カット。装飾のみでコンテンツを持たないためaria-hidden。
		    reduced-motion時はCSS側で即座に非表示にする */}
		<div class="logo-intro" aria-hidden="true">
			<Image src={heroLogo} alt="" widths={[160, 240]} sizes="18vw" loading="eager" fetchpriority="high" />
		</div>

		<header class="site-header" aria-label="メインナビゲーション">
			<a class="brand" href="#top" aria-label="ROOM トップへ">ROOM</a>
			<nav>
				<a href="#about">公演について</a>
				<a href="#information">開催情報</a>
				<a class="nav-instagram" href="https://www.instagram.com/ryuikeion/" target="_blank" rel="noopener">Instagram<span aria-hidden="true">↗</span></a>
				<a class="ticket-link header-ticket is-internal" href="#tickets"><span>購入</span><span aria-hidden="true">↓</span></a>
			</nav>
		</header>

		<main id="content">
			<section class="hero" id="top" aria-labelledby="hero-title">
				<div class="hero-aperture" aria-hidden="true">
					<Image src={heroPhoto} alt="" class="hero-aperture-photo" widths={[480, 900, 1400]} sizes="47vw" loading="eager" fetchpriority="high" />
					<div class="aperture-line"></div>
				</div>
				<div class="hero-kicker">
					<span>Ryuik-on presents</span>
					<span>LIVE 2026</span>
				</div>
				<div class="hero-main">
					<h1 id="hero-title">ROOM</h1>
					<p>一つの公演を、本気でつくる。</p>
				</div>
				<div class="hero-meta">
					<div>
						<span class="meta-label">DATE</span>
						<strong>2026.11.22</strong>
						<span>SUN</span>
					</div>
					<div>
						<span class="meta-label">TIME</span>
						<strong>OPEN {eventInfo.open}</strong>
						<span>START {eventInfo.start}</span>
					</div>
					<div>
						<span class="meta-label">PLACE</span>
						<strong>{eventInfo.venueName}</strong>
						<span>{eventInfo.venueHall}</span>
					</div>
					<a class="ticket-link is-internal" href="#tickets"><span>チケットを購入する</span><span aria-hidden="true">↓</span></a>
				</div>
				<a class="scroll-cue" href="#about">
					<span>SCROLL</span>
					<i aria-hidden="true"></i>
				</a>
			</section>

			<section class="statement section-pad" id="about" aria-labelledby="about-title">
				<div class="section-index reveal">01 / ABOUT</div>
				<div class="statement-copy reveal">
					<h2 id="about-title">見せたいのは、完成した音だけではない。</h2>
					<p>
						音を合わせては崩れ、また合わせる。客席に届く音として聴き直し、曲順や間、光までも組み直す。
						その繰り返しの先に、一度きりの演奏があります。
						ROOMは、{eventInfo.organizer}が、一つの公演をつくり上げるライブです。
					</p>
				</div>
			</section>

			<section class="scene section-pad" aria-labelledby="scene-title">
				<div class="section-heading reveal">
					<div class="section-index">02 / SCENE</div>
					<h2 id="scene-title">その場に、音がある。</h2>
				</div>
				<ul class="scene-grid">
					{photos.map((photo, i) => (
						<li class="scene-frame reveal">
							<span class="scene-number">{String(i + 1).padStart(2, "0")}</span>
							<Image src={photo.src} alt={photo.alt} widths={[420, 700, 960]} sizes="(min-width: 800px) 31vw, 92vw" loading="lazy" decoding="async" />
						</li>
					))}
				</ul>
				<p class="scene-caption reveal">写真はいずれも過去公演の記録より</p>
				<p class="scene-copy reveal">
					音を鳴らしている姿。<br />
					その姿から伝わる熱は、<br />
					必要としている誰かに届くはずです。
				</p>
			</section>

			<section class="invitation section-pad" aria-labelledby="founder-title">
				<div class="invitation-rule reveal" aria-hidden="true"><span class="invitation-num">03</span></div>
				<div class="invitation-copy reveal">
					<div class="section-index">03 / FOUNDER'S NOTE</div>
					<h2 id="founder-title">だから、この夜をつくります。</h2>
					<p>
						鳴らした音を、届くべき人へ。<br />
						それを目の当たりにすれば、自分だけじゃないと思えるかもしれません。
					</p>
				</div>
			</section>

			<section class="information section-pad" id="information" aria-labelledby="info-title">
				<div class="section-heading reveal">
					<div class="section-index">04 / INFORMATION</div>
					<h2 id="info-title">INFORMATION</h2>
				</div>
				<div class="info-board reveal">
					<div class="date-block">
						<span>2026</span>
						<strong>11.22</strong>
						<em>SUN</em>
					</div>
					<dl>
						<div>
							<dt>OPEN</dt>
							<dd>{eventInfo.open}</dd>
						</div>
						<div>
							<dt>START</dt>
							<dd>{eventInfo.start}</dd>
						</div>
						<div>
							<dt>終演目安</dt>
							<dd>{eventInfo.endEstimate}</dd>
						</div>
						<div>
							<dt>VENUE</dt>
							<dd>
								{eventInfo.venueName}
								<small>{eventInfo.venueHall}</small>
							</dd>
						</div>
						<div>
							<dt>HOST</dt>
							<dd>
								{eventInfo.organizer}
							</dd>
						</div>
					</dl>
				</div>
			</section>

			<section class="tickets section-pad" id="tickets" aria-labelledby="ticket-title">
				<div class="section-heading reveal">
					<div class="section-index">05 / TICKET</div>
					<h2 id="ticket-title">TICKET</h2>
				</div>
				<div class="price-list reveal">
					{prices.map((item) => (
						<div class="price-row">
							<span>{item.label}</span>
							<strong>{item.price}</strong>
							<small>{item.note}</small>
						</div>
					))}
				</div>
				<div class="ticket-action reveal">
					<a
						class="ticket-link ticket-cta is-pending"
						href={ticketUrl}
						target="_blank"
						rel="noopener"
						data-ticket-cta
						data-sale-start={saleStartISO}
						aria-disabled="true"
					>
						<span data-ticket-label>販売開始までお待ちください</span>
						<span aria-hidden="true">↗</span>
					</a>
					<p>
						前売券は{saleStartLabel}販売開始。teket（外部サイト）での販売です。<br />
						当日券は前売りの残数がある場合のみ販売します。
					</p>
				</div>
				<div class="ticket-faq reveal">
					<details>
						<summary>小人・学生料金の対象について<span aria-hidden="true"></span></summary>
						<p>小人は小学生以下（未就学児を含む）が対象です。学生は当日、学生証をご提示ください。</p>
					</details>
					<details>
						<summary>当日券について<span aria-hidden="true"></span></summary>
						<p>当日券は、前売り券に残数がある場合のみ販売します。</p>
					</details>
					<details>
						<summary>初めてRyuik-onを見る方へ<span aria-hidden="true"></span></summary>
						<p>どなたにも一つのライブとして楽しんでいただける公演を目指しています。</p>
					</details>
				</div>
			</section>

			<section class="venue section-pad" aria-labelledby="venue-title">
				<div class="section-heading reveal">
					<div class="section-index">06 / VENUE</div>
					<h2 id="venue-title">会場へ。</h2>
				</div>
				<div class="venue-grid reveal">
					<div class="venue-map" aria-hidden="true">
						<span class="map-line map-line-one"></span>
						<span class="map-line map-line-two"></span>
						<span class="map-line map-line-three"></span>
						<i></i>
						<b>ROOM</b>
					</div>
					<div class="venue-copy">
						<h3>{venueFull}</h3>
						<p>〒900-0013 沖縄県那覇市牧志3-2-10 てんぶす那覇4階</p>
						<p>ゆいレール牧志駅から徒歩約5分（有料駐車場81台あり）</p>
						<a class="text-link" href={mapUrl} target="_blank" rel="noopener">地図を開く <span aria-hidden="true">↗</span></a>
					</div>
				</div>
			</section>

			<section class="final-cta" aria-labelledby="final-title">
				<div class="final-aperture" aria-hidden="true">
					<Image src={heroPhoto} alt="" class="final-aperture-photo" widths={[600, 1000, 1600]} sizes="100vw" loading="lazy" decoding="async" />
				</div>
				<div class="final-inner reveal">
					<span>Ryuik-on presents</span>
					<h2 id="final-title">11月22日、ROOMで。</h2>
					<p>
						OPEN {eventInfo.open} / START {eventInfo.start}<br />
						{venueFull}
					</p>
					<a class="ticket-link is-internal" href="#tickets"><span>チケットを購入する</span><span aria-hidden="true">↓</span></a>
				</div>
			</section>
		</main>

		<footer>
			<div class="footer-brand">
				<a class="footer-room" href="#top">ROOM</a>
				<p>{eventInfo.organizer}</p>
			</div>
			<div class="footer-links">
				<a class="footer-instagram" href="https://www.instagram.com/ryuikeion/" target="_blank" rel="noopener">
					<span>Instagram<span aria-hidden="true">↗</span></span>
					<small>最新情報の発信・お問い合わせはDMへ</small>
				</a>
				<a href="https://ryuik-on.github.io/ryuik-on-official" target="_blank" rel="noopener">
					公式サイト
					<small>琉球大学医学部を拠点に活動する軽音部、Ryuik-onについて</small>
				</a>
			</div>
			<p class="copyright">&copy; 2026 {eventInfo.organizer}</p>
		</footer>

		<div class="mobile-ticket-bar" data-mobile-ticket-bar>
			<div>
				<strong>11.22 SUN</strong>
				<span>一般 ¥1,500</span>
			</div>
			<a class="ticket-link is-internal" href="#tickets"><span>購入する</span><span aria-hidden="true">↓</span></a>
		</div>

		<script>
			const ticketSection = document.querySelector("#tickets");
			const mobileBar = document.querySelector("[data-mobile-ticket-bar]");

			// reveal演出はIntersectionObserverを使わず、スクロール位置から直接判定する。
			// IOはバックグラウンドタブ・アプリ内ブラウザ（Instagram等）・prerender中に
			// 発火しないことがあり、その場合コンテンツが非表示のまま残るため。
			const pendingReveals = new Set(document.querySelectorAll(".reveal"));
			const updateReveals = () => {
				const threshold = window.innerHeight * 0.86;
				pendingReveals.forEach((node) => {
					if (node.getBoundingClientRect().top < threshold) {
						node.classList.add("is-visible");
						pendingReveals.delete(node);
					}
				});
			};

			// reduced-motion時もバーは表示する（transitionはCSS側で無効化される）
			const onScroll = () => {
				const rect = ticketSection?.getBoundingClientRect();
				const ticketVisible = rect ? rect.top < window.innerHeight * 0.85 && rect.bottom > 100 : false;
				mobileBar?.classList.toggle("is-active", window.scrollY > window.innerHeight * 0.72 && !ticketVisible);
				updateReveals();
			};
			window.addEventListener("scroll", onScroll, { passive: true });
			window.addEventListener("resize", updateReveals, { passive: true });
			// bfcache復帰・タブ再表示でも取りこぼさない
			window.addEventListener("pageshow", updateReveals);
			document.addEventListener("visibilitychange", updateReveals);
			onScroll();

			// 最終保険：hidden状態のドキュメントはscrollイベントの配信自体が止まる環境がある
			// （埋め込みWebView等）。タイマーはその状態でも動くので、未表示が残る限り
			// 定期的に判定し、全て表示し終えたら止める。
			const revealTimer = setInterval(() => {
				updateReveals();
				if (pendingReveals.size === 0) clearInterval(revealTimer);
			}, 800);

			// 販売開始日時の自動切り替え：teket URLは主催者確定済みのため常にhrefへ
			// 埋め込んでいるが（JSON-LDのofferも同様）、8/22までは誤って踏めないよう
			// aria-disabled化しクリックを無効化する。以降は通常のリンクとして機能する
			document.querySelectorAll("[data-ticket-cta]").forEach((el) => {
				if (!(el instanceof HTMLAnchorElement)) return;
				const saleStart = el.dataset.saleStart;
				const onSale = saleStart ? new Date() >= new Date(saleStart) : false;
				if (onSale) {
					el.classList.remove("is-pending");
					el.removeAttribute("aria-disabled");
					const label = el.querySelector("[data-ticket-label]");
					if (label) label.textContent = "チケットを購入する";
				} else {
					el.addEventListener("click", (e) => e.preventDefault());
				}
			});
		</script>

		<style is:global>
			/* @font-face はbase pathを埋め込むため、head内で fontFaceCss として注入している */

			:root {
				color-scheme: dark;
				--ink: #080808;
				--soft-black: #111111;
				--warm-white: #f1efe9;
				--ash: #aaa7a0;
				--vermilion: #a94738;
				--hairline: #2a2927;
			}

			* {
				box-sizing: border-box;
			}

			html {
				scroll-behavior: smooth;
				background: var(--ink);
			}

			body {
				margin: 0;
				background: var(--ink);
				color: var(--warm-white);
				font-family: "Archivo Variable", "Hiragino Kaku Gothic ProN", "Hiragino Sans", "Noto Sans JP", "Yu Gothic", sans-serif;
				font-weight: 400;
				letter-spacing: 0.01em;
				-webkit-font-smoothing: antialiased;
			}

			a {
				color: inherit;
				text-decoration: none;
			}

			button,
			a {
				-webkit-tap-highlight-color: transparent;
			}

			a:focus-visible,
			summary:focus-visible {
				outline: 2px solid var(--vermilion);
				outline-offset: 4px;
			}

			main {
				overflow: clip;
			}

			.skip-link {
				position: absolute;
				left: -9999px;
				top: 0;
				z-index: 100;
				background: var(--vermilion);
				color: var(--warm-white);
				padding: 10px 18px;
			}
			.skip-link:focus {
				left: 0;
			}

			/* ---- Header ---- */
			.site-header {
				position: fixed;
				top: 0;
				left: 0;
				z-index: 30;
				display: flex;
				width: 100%;
				height: 76px;
				align-items: center;
				justify-content: space-between;
				padding: 0 3.25vw;
			}
			/* 明るい写真の上でも読めるよう、文字要素だけを差の合成にする。
			   購入ボタンは不透明な通常描画にして、見え方を背景に依存させない */
			.site-header .brand,
			.site-header nav > a:not(.header-ticket) {
				mix-blend-mode: difference;
			}
			.brand,
			.footer-room {
				font-family: "Archivo Variable", sans-serif;
				font-size: 17px;
				font-weight: 600;
				letter-spacing: 0.22em;
			}
			.site-header nav {
				display: flex;
				align-items: center;
				gap: 34px;
				font-size: 12px;
			}
			.site-header nav > a:not(.ticket-link) {
				color: #e5e2db;
			}
			.nav-instagram span {
				margin-left: 3px;
				font-size: 10px;
			}

			.ticket-link {
				display: inline-flex;
				min-height: 52px;
				min-width: 220px;
				align-items: center;
				justify-content: space-between;
				gap: 28px;
				border: 1px solid var(--warm-white);
				border-radius: 2px;
				background: var(--warm-white);
				color: var(--ink);
				padding: 0 20px;
				font-size: 14px;
				font-weight: 500;
				transition: color 180ms ease, background 180ms ease, opacity 180ms ease;
			}
			.ticket-link > span:last-child {
				transition: transform 180ms ease;
			}
			.ticket-link:hover {
				background: transparent;
				color: var(--warm-white);
			}
			.ticket-link:hover > span:last-child {
				transform: translate(3px, -3px);
			}
			/* ページ内ジャンプのボタンは「↓」なので、hover時も下方向に動かす */
			.ticket-link.is-internal:hover > span:last-child {
				transform: translateY(3px);
			}
			.ticket-link.is-pending {
				opacity: 0.55;
				cursor: not-allowed;
			}
			.ticket-link.is-pending:hover {
				background: var(--warm-white);
				color: var(--ink);
			}
			.ticket-link.is-pending:hover > span:last-child {
				transform: none;
			}

			.site-header .header-ticket {
				min-height: 38px;
				min-width: 116px;
				padding-inline: 16px;
			}

			/* ---- Logo intro (Hero扉が開く前の一瞬のロゴ単体カット) ---- */
			.logo-intro {
				position: fixed;
				inset: 0;
				z-index: 60;
				display: flex;
				align-items: center;
				justify-content: center;
				background: var(--ink);
				pointer-events: none;
				animation: room-logo-intro 1.1s cubic-bezier(0.22, 1, 0.36, 1) forwards;
			}
			.logo-intro img {
				width: min(18vw, 120px);
				height: auto;
			}
			@keyframes room-logo-intro {
				0%,
				55% {
					opacity: 1;
				}
				100% {
					opacity: 0;
				}
			}

			/* ---- Hero ---- */
			.hero {
				position: relative;
				min-height: 100svh;
				padding: 100px 3.25vw 42px;
				border-bottom: 1px solid var(--hairline);
				isolation: isolate;
			}
			.hero-aperture {
				--aperture-width: min(47vw, 720px);
				position: absolute;
				top: 0;
				right: 3.25vw;
				bottom: 190px;
				z-index: -1;
				width: 5px;
				min-width: 5px;
				overflow: hidden;
				background: var(--warm-white);
				/* ロゴ単体カット（.logo-intro、0.6sからフェード開始）が引くのに合わせて開き始める */
				animation: room-aperture-open 1.8s cubic-bezier(0.22, 1, 0.36, 1) 0.6s forwards;
			}
			@keyframes room-aperture-open {
				to {
					width: var(--aperture-width);
				}
			}
			.hero-aperture .hero-aperture-photo {
				position: absolute;
				inset: 0;
				width: min(47vw, 720px);
				max-width: none;
				height: 100%;
				object-fit: cover;
				object-position: 40% 30%;
				filter: grayscale(1) contrast(1.05) brightness(1.08);
				opacity: 0.32;
				mix-blend-mode: multiply;
			}
			.aperture-line {
				position: absolute;
				top: 0;
				left: 50%;
				width: 1px;
				height: 100%;
				background: rgba(8, 8, 8, 0.22);
			}

			.hero-kicker {
				display: flex;
				justify-content: space-between;
				font-size: 10px;
				letter-spacing: 0.18em;
				text-transform: uppercase;
				/* 写真帯に重なっても読めるように反転合成 */
				mix-blend-mode: difference;
			}
			.hero-main {
				position: absolute;
				top: 46%;
				left: 3.25vw;
				transform: translateY(-50%);
			}
			.hero-main h1 {
				margin: 0 0 18px;
				font-family: "Archivo Variable", sans-serif;
				font-size: clamp(88px, 15.5vw, 244px);
				font-stretch: 62%;
				font-weight: 300;
				letter-spacing: -0.02em;
				line-height: 0.75;
			}
			.hero-main p {
				margin: 0 0 0 0.6vw;
				font-size: clamp(21px, 2vw, 32px);
				font-weight: 400;
				letter-spacing: 0.06em;
			}
			.hero-meta {
				position: absolute;
				right: 3.25vw;
				bottom: 42px;
				left: 3.25vw;
				display: grid;
				grid-template-columns: 1.15fr 1.15fr 1.8fr auto;
				gap: 22px;
				align-items: end;
			}
			.hero-meta > div {
				display: grid;
				min-height: 76px;
				align-content: start;
				border-top: 1px solid currentColor;
				padding-top: 10px;
			}
			.hero-meta strong,
			.hero-meta span {
				font-size: 12px;
				font-style: normal;
				line-height: 1.6;
			}
			.hero-meta .meta-label {
				margin-bottom: 8px;
				color: var(--ash);
				font-size: 9px;
				letter-spacing: 0.16em;
			}

			.scroll-cue {
				position: absolute;
				right: 3.25vw;
				top: 40%;
				display: flex;
				align-items: center;
				gap: 12px;
				mix-blend-mode: difference;
				color: var(--ash);
				font-size: 9px;
				letter-spacing: 0.14em;
				transform: rotate(90deg);
				transform-origin: right center;
			}
			.scroll-cue i {
				display: block;
				width: 42px;
				height: 1px;
				background: currentColor;
			}

			/* ---- 共通セクション ---- */
			.section-pad {
				padding: 180px 6.5vw;
			}
			.section-index {
				color: var(--ash);
				font-size: 10px;
				letter-spacing: 0.18em;
				font-variant-numeric: tabular-nums;
			}

			.statement {
				display: grid;
				min-height: 94svh;
				grid-template-columns: 3fr 9fr;
				align-items: start;
			}
			.statement-copy {
				max-width: 1000px;
			}
			.statement h2,
			.section-heading h2,
			.invitation h2,
			.final-cta h2 {
				margin: 0;
				font-family: "Archivo Variable", sans-serif;
				font-size: clamp(42px, 5.6vw, 84px);
				font-stretch: 88%;
				font-weight: 300;
				letter-spacing: -0.01em;
				line-height: 1.26;
			}
			.statement p,
			.invitation p {
				max-width: 630px;
				margin: 72px 0 0 auto;
				color: var(--ash);
				font-size: clamp(16px, 1.3vw, 19px);
				line-height: 2.05;
			}

			.section-heading {
				display: grid;
				grid-template-columns: 3fr 9fr;
				align-items: start;
				margin-bottom: 96px;
			}

			/* C: セクション番号をデスクトップでsticky化 */
			@media (min-width: 900px) {
				.statement > .section-index,
				.section-heading > .section-index {
					position: sticky;
					top: 100px;
					align-self: start;
				}
			}

			/* ---- A: SCENE（写真を罫線システムに組み込む） ---- */
			.scene {
				border-top: 1px solid var(--hairline);
			}
			.scene-grid {
				list-style: none;
				margin: 0 0 18px;
				padding: 0;
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1px;
				background: var(--hairline);
				border: 1px solid var(--hairline);
			}
			.scene-frame {
				position: relative;
				aspect-ratio: 4 / 3;
				overflow: hidden;
				background: var(--soft-black);
			}
			.scene-number {
				position: absolute;
				top: 14px;
				left: 14px;
				z-index: 1;
				color: var(--warm-white);
				font-size: 10px;
				letter-spacing: 0.12em;
				font-variant-numeric: tabular-nums;
				mix-blend-mode: difference;
			}
			.scene-frame img {
				display: block;
				width: 100%;
				height: 100%;
				object-fit: cover;
			}
			.scene-caption {
				margin: 0 0 88px;
				color: var(--ash);
				font-size: 12px;
				letter-spacing: 0.08em;
			}
			.scene-copy {
				max-width: 640px;
				margin: 0 0 0 auto;
				color: var(--ash);
				font-size: clamp(16px, 1.3vw, 19px);
				line-height: 2.1;
				text-align: right;
			}
			/* D: 試作。デスクトップのみ縦書き。 data-vertical-concept を付けた場合のみ有効 */
			@media (min-width: 900px) {
				[data-vertical-concept] .scene-copy {
					writing-mode: vertical-rl;
					text-orientation: mixed;
					max-width: none;
					height: 320px;
					margin: 0 0 0 auto;
					line-height: 2.4;
					text-align: left;
				}
			}

			/* ---- FOUNDER'S NOTE ---- */
			.invitation {
				display: grid;
				min-height: 88svh;
				grid-template-columns: 1fr 1fr;
				align-items: center;
			}
			.invitation-rule {
				position: relative;
				display: flex;
				align-items: center;
				justify-content: center;
				height: 56vh;
				max-height: 640px;
				border-left: 1px solid var(--hairline);
			}
			.invitation-num {
				color: var(--ash);
				opacity: 0.55;
				font-family: "Archivo Variable", sans-serif;
				font-size: clamp(64px, 9vw, 160px);
				font-stretch: 68%;
				font-weight: 300;
				letter-spacing: -0.01em;
				line-height: 1;
				font-variant-numeric: tabular-nums;
			}
			.invitation-copy {
				padding-left: 8vw;
			}
			.invitation-copy .section-index {
				margin-bottom: 42px;
			}
			.invitation h2 {
				font-size: clamp(38px, 4.5vw, 68px);
			}
			.invitation p {
				margin: 52px 0 0;
			}

			/* ---- INFORMATION（他セクションと同じ黒基調・白文字） ---- */
			.information {
				background: var(--ink);
				color: var(--warm-white);
			}
			.information .section-index {
				color: var(--ash);
			}
			.info-board {
				display: grid;
				grid-template-columns: 5fr 7fr;
				border-top: 1px solid var(--hairline);
				border-bottom: 1px solid var(--hairline);
			}
			.date-block {
				display: grid;
				align-content: space-between;
				min-height: 500px;
				border-right: 1px solid var(--hairline);
				padding: 30px 36px 30px 0;
			}
			.date-block span,
			.date-block em {
				font-size: 12px;
				font-style: normal;
				letter-spacing: 0.14em;
			}
			.date-block strong {
				font-family: "Archivo Variable", sans-serif;
				font-size: clamp(90px, 10vw, 160px);
				font-stretch: 70%;
				font-weight: 300;
				letter-spacing: -0.02em;
				line-height: 0.85;
			}
			.info-board dl {
				margin: 0;
			}
			.info-board dl > div {
				display: grid;
				min-height: 108px;
				grid-template-columns: 1fr 2.5fr;
				align-items: start;
				border-bottom: 1px solid var(--hairline);
				padding: 24px 0 18px 38px;
			}
			.info-board dl > div:last-child {
				border-bottom: 0;
			}
			.info-board dt {
				color: var(--ash);
				font-size: 10px;
				letter-spacing: 0.16em;
			}
			.info-board dd {
				margin: 0;
				font-size: clamp(18px, 1.7vw, 26px);
				font-weight: 400;
			}
			.info-board dd small {
				display: block;
				margin-top: 7px;
				color: var(--ash);
				font-size: 13px;
			}

			/* ---- TICKET ---- */
			.tickets {
				border-bottom: 1px solid var(--hairline);
			}
			.price-list {
				border-top: 1px solid var(--hairline);
			}
			.price-row {
				display: grid;
				min-height: 130px;
				grid-template-columns: 2fr 3fr 3fr;
				align-items: center;
				border-bottom: 1px solid var(--hairline);
			}
			.price-row > span {
				font-size: 18px;
			}
			.price-row strong {
				font-family: "Archivo Variable", sans-serif;
				font-size: clamp(42px, 5vw, 70px);
				font-stretch: 80%;
				font-weight: 300;
				letter-spacing: -0.01em;
				font-variant-numeric: tabular-nums;
			}
			.price-row small {
				color: var(--ash);
				font-size: 12px;
			}

			.ticket-action {
				display: grid;
				grid-template-columns: auto 1fr;
				gap: 40px;
				align-items: center;
				margin: 66px 0 100px;
			}
			.ticket-action p {
				max-width: 580px;
				margin: 0;
				color: var(--ash);
				font-size: 13px;
				line-height: 1.8;
			}

			.ticket-faq {
				margin-left: 25%;
				border-top: 1px solid var(--hairline);
			}
			.ticket-faq details {
				border-bottom: 1px solid var(--hairline);
			}
			.ticket-faq summary {
				display: flex;
				min-height: 70px;
				align-items: center;
				justify-content: space-between;
				cursor: pointer;
				font-size: 14px;
				list-style: none;
			}
			.ticket-faq summary::-webkit-details-marker {
				display: none;
			}
			.ticket-faq summary span {
				color: var(--ash);
				font-size: 19px;
			}
			.ticket-faq summary span::before {
				content: "+";
			}
			.ticket-faq details[open] summary span::before {
				content: "−";
			}
			.ticket-faq details p {
				max-width: 600px;
				margin: 0 0 26px;
				color: var(--ash);
				font-size: 13px;
				line-height: 1.8;
			}

			/* ---- VENUE ---- */
			.venue-grid {
				display: grid;
				grid-template-columns: 7fr 5fr;
				gap: 7vw;
				align-items: center;
			}
			.venue-map {
				position: relative;
				min-height: 480px;
				overflow: hidden;
				border: 1px solid var(--hairline);
				background: var(--soft-black);
			}
			.map-line {
				position: absolute;
				display: block;
				height: 1px;
				background: #3c3a36;
				transform-origin: center;
			}
			.map-line-one {
				top: 36%;
				left: -8%;
				width: 116%;
				transform: rotate(-8deg);
			}
			.map-line-two {
				top: 62%;
				left: -8%;
				width: 116%;
				transform: rotate(11deg);
			}
			.map-line-three {
				top: 0;
				left: 58%;
				width: 100%;
				transform: rotate(84deg);
			}
			.venue-map i {
				position: absolute;
				top: 48%;
				left: 55%;
				width: 11px;
				height: 11px;
				border-radius: 50%;
				background: var(--vermilion);
				box-shadow: 0 0 0 8px rgba(169, 71, 56, 0.12);
			}
			.venue-map b {
				position: absolute;
				top: calc(48% + 22px);
				left: 55%;
				font-family: "Archivo Variable", sans-serif;
				font-size: 10px;
				font-weight: 500;
				letter-spacing: 0.12em;
			}
			.venue-copy h3 {
				margin: 0 0 8px;
				font-size: clamp(22px, 2.2vw, 34px);
				font-weight: 400;
				line-height: 1.4;
			}
			.venue-copy p {
				margin: 7px 0;
				color: var(--ash);
				font-size: 14px;
				line-height: 1.8;
			}
			.text-link {
				display: inline-flex;
				align-items: center;
				gap: 14px;
				margin-top: 40px;
				border-bottom: 1px solid var(--warm-white);
				padding-bottom: 7px;
				font-size: 13px;
			}

			/* ---- FINAL CTA（E: IMG_9599を敷く） ---- */
			.final-cta {
				position: relative;
				display: grid;
				min-height: 100svh;
				place-items: center;
				border-top: 1px solid var(--hairline);
				text-align: center;
				isolation: isolate;
			}
			.final-aperture {
				position: absolute;
				inset: 13% 8%;
				z-index: -1;
				overflow: hidden;
				background: var(--warm-white);
			}
			.final-aperture .final-aperture-photo {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				object-fit: cover;
				object-position: 50% 30%;
				filter: grayscale(1) contrast(1.05);
				opacity: 0.22;
				mix-blend-mode: multiply;
			}
			.final-inner {
				position: relative;
				color: var(--ink);
			}
			.final-inner > span {
				display: block;
				margin-bottom: 44px;
				font-size: 10px;
				letter-spacing: 0.16em;
				text-transform: uppercase;
			}
			.final-cta h2 {
				font-size: clamp(42px, 6vw, 92px);
			}
			.final-cta p {
				margin: 38px 0;
				font-size: 13px;
				line-height: 1.9;
			}
			.final-cta .ticket-link {
				margin: 0 auto;
				border-color: var(--ink);
				background: var(--ink);
				color: var(--warm-white);
			}
			.final-cta .ticket-link:hover {
				background: transparent;
				color: var(--ink);
			}

			/* ---- Footer ---- */
			footer {
				display: grid;
				grid-template-columns: 1fr auto;
				gap: 40px 60px;
				border-top: 1px solid var(--hairline);
				padding: 60px 3.25vw;
			}
			.footer-brand p {
				margin: 10px 0 0;
				color: var(--ash);
				font-size: 12px;
			}
			.footer-links {
				display: grid;
				gap: 20px;
				font-size: 13px;
			}
			.footer-links a {
				display: block;
			}
			.footer-links small {
				display: block;
				margin-top: 4px;
				color: var(--ash);
				font-size: 11px;
			}
			/* Instagramは最新情報・問い合わせの主要導線のため、公式サイトより一段目立たせる */
			.footer-instagram span {
				display: inline-flex;
				align-items: center;
				gap: 6px;
				font-family: "Archivo Variable", sans-serif;
				font-size: 20px;
				font-weight: 600;
				letter-spacing: 0.02em;
				transition: gap 180ms ease;
			}
			.footer-instagram span[aria-hidden] {
				font-size: 14px;
			}
			.footer-instagram:hover span {
				gap: 10px;
			}
			.footer-instagram small {
				margin-top: 6px;
				font-size: 12px;
			}
			.copyright {
				grid-column: 1 / -1;
				margin: 0;
				color: var(--ash);
				font-size: 11px;
			}

			.mobile-ticket-bar {
				display: none;
			}

			/* JSが動く環境（html.js）でのみ初期非表示にする。
			   JS無効時は確定情報と導線がそのまま見える */
			html.js .reveal {
				opacity: 0;
				transform: translateY(16px);
				transition: opacity 650ms cubic-bezier(0.22, 1, 0.36, 1), transform 650ms cubic-bezier(0.22, 1, 0.36, 1);
			}
			html.js .reveal.is-visible {
				opacity: 1;
				transform: translateY(0);
			}

			@media (max-width: 800px) {
				.site-header {
					height: 62px;
					padding: 0 20px;
				}
				.site-header nav > a:not(.header-ticket) {
					display: none;
				}
				.site-header .header-ticket {
					min-width: 96px;
					min-height: 36px;
				}

				.hero {
					min-height: 100svh;
					padding: 80px 20px 28px;
				}
				/* モバイルでは見出し・タグラインが帯に重なるため、帯を暗い写真にして
				   温白の文字が常に読めるようにする（白い帯はデスクトップのみ） */
				.hero-aperture {
					--aperture-width: 48vw;
					right: 22px;
					bottom: 300px;
					width: 4px;
					background: var(--soft-black);
					border: 1px solid var(--hairline);
				}
				.hero-aperture .hero-aperture-photo {
					width: 48vw;
					mix-blend-mode: normal;
					opacity: 0.5;
					filter: grayscale(1) contrast(1.05) brightness(0.7);
				}
				.aperture-line {
					background: rgba(241, 239, 233, 0.14);
				}
				.hero-kicker {
					max-width: 68vw;
				}
				.hero-main {
					top: 37%;
					left: 20px;
				}
				.hero-main h1 {
					margin-bottom: 24px;
					font-size: clamp(78px, 27vw, 120px);
				}
				.hero-main p {
					max-width: 85vw;
					margin: 0;
					font-size: 22px;
					line-height: 1.55;
				}
				.hero-meta {
					right: 20px;
					bottom: 26px;
					left: 20px;
					grid-template-columns: 1fr 1fr;
					gap: 18px 12px;
				}
				.hero-meta > div {
					min-height: 64px;
				}
				.hero-meta > div:nth-child(3) {
					grid-column: 1 / -1;
				}
				.hero-meta .ticket-link {
					width: 100%;
					grid-column: 1 / -1;
				}
				.scroll-cue {
					display: none;
				}

				.section-pad {
					padding: 108px 22px;
				}

				.statement {
					display: block;
					min-height: auto;
				}
				.statement .section-index,
				.section-heading .section-index {
					margin-bottom: 42px;
					position: static;
				}
				.statement h2,
				.section-heading h2,
				.invitation h2,
				.final-cta h2 {
					font-size: 38px;
				}
				.statement p,
				.invitation p {
					margin: 52px 0 0;
					font-size: 16px;
					line-height: 1.95;
				}
				.section-heading {
					display: block;
					margin-bottom: 62px;
				}

				.scene-grid {
					grid-template-columns: 1fr;
				}
				.scene-copy {
					text-align: left;
					margin: 0;
				}

				.invitation {
					display: block;
					min-height: auto;
				}
				/* モバイルではゴースト数字＋縦線の帯は空走になるだけなので出さない */
				.invitation-rule {
					display: none;
				}
				.invitation-copy {
					padding: 0;
				}

				.info-board {
					display: block;
				}
				.date-block {
					min-height: 280px;
					border-right: 0;
					border-bottom: 1px solid var(--hairline);
					padding-right: 0;
				}
				.date-block strong {
					font-size: 84px;
				}
				.info-board dl > div {
					min-height: 96px;
					grid-template-columns: 1fr 2fr;
					padding: 20px 0;
				}
				.info-board dd {
					font-size: 18px;
				}

				.price-row {
					min-height: 112px;
					grid-template-columns: 1fr auto;
					gap: 10px;
				}
				.price-row strong {
					font-size: 42px;
				}
				.price-row small {
					grid-column: 1 / -1;
					padding-bottom: 16px;
				}

				.ticket-action {
					display: block;
					margin: 48px 0 80px;
				}
				.ticket-action .ticket-link {
					width: 100%;
				}
				.ticket-action p {
					margin-top: 24px;
				}
				.ticket-faq {
					margin-left: 0;
				}

				.venue-grid {
					display: flex;
					flex-direction: column;
					gap: 46px;
					align-items: stretch;
				}
				/* 抽象地図は情報を持たない装飾なので、面積の貴重なモバイルでは出さない */
				.venue-map {
					display: none;
				}

				.final-cta {
					min-height: 82svh;
					padding-inline: 34px;
				}
				.final-aperture {
					inset: 9% 10px;
				}
				.final-inner > span {
					margin-bottom: 30px;
				}
				.final-cta h2 {
					font-size: 36px;
				}
				.final-cta p {
					font-size: 12px;
				}
				.final-cta .ticket-link {
					width: min(100%, 300px);
				}

				footer {
					display: flex;
					flex-direction: column;
					gap: 30px;
					padding: 46px 22px 110px;
				}

				.mobile-ticket-bar {
					position: fixed;
					right: 10px;
					bottom: max(10px, env(safe-area-inset-bottom));
					left: 10px;
					z-index: 40;
					display: flex;
					align-items: center;
					justify-content: space-between;
					border: 1px solid #d7d3cb;
					border-radius: 3px;
					background: rgba(241, 239, 233, 0.96);
					color: var(--ink);
					padding: 8px 8px 8px 15px;
					opacity: 0;
					pointer-events: none;
					transform: translateY(calc(100% + 24px));
					transition: opacity 260ms ease, transform 360ms cubic-bezier(0.22, 1, 0.36, 1);
					backdrop-filter: blur(12px);
				}
				.mobile-ticket-bar.is-active {
					opacity: 1;
					pointer-events: auto;
					transform: translateY(0);
				}
				.mobile-ticket-bar > div {
					display: grid;
					gap: 2px;
				}
				.mobile-ticket-bar strong {
					font-size: 12px;
				}
				.mobile-ticket-bar > div span {
					color: #6c6962;
					font-size: 10px;
				}
				.mobile-ticket-bar .ticket-link {
					min-width: 116px;
					min-height: 46px;
					border-color: var(--ink);
					background: var(--ink);
					color: var(--warm-white);
					padding-inline: 14px;
				}
			}

			@media (prefers-reduced-motion: reduce) {
				*,
				*::before,
				*::after {
					scroll-behavior: auto !important;
					animation-duration: 0.01ms !important;
					animation-delay: 0s !important;
					animation-iteration-count: 1 !important;
					transition-duration: 0.01ms !important;
				}
				.reveal {
					opacity: 1 !important;
					transform: none !important;
				}
			}
		</style>
	</body>
</html>
