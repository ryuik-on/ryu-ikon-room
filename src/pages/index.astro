---
import { Image } from "astro:assets";
import heroPhoto from "../assets/hero/hero-photo.jpg";
import heroLogo from "../assets/hero/ryuikon-logo.png";
import photo01 from "../assets/photos/photo-01.jpg";
import photo02 from "../assets/photos/photo-02.jpg";
import photo03 from "../assets/photos/photo-03.jpg";

// 素材はすべて部内撮影・使用可確認済み（facts-and-content.md参照）
const photos = [
  { src: photo01, alt: "マイクに向かって手を伸ばすボーカルと、それに応える観客たち" },
  { src: photo02, alt: "目を閉じてギターを弾く奏者" },
  { src: photo03, alt: "両手を上げて盛り上がる観客と、それを見守る奏者" },
];

const eventInfo = {
  organizer: "琉球大学医学部軽音部（Ryuik-on）",
  date: "2026年11月22日（日）",
  open: "16:00",
  start: "17:00",
  endEstimate: "20:00頃",
  venue: "那覇市ぶんかテンブス館 テンブスホール",
};

const mapUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(eventInfo.venue)}`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "MusicEvent",
  name: "ROOM",
  startDate: "2026-11-22T17:00:00+09:00",
  endDate: "2026-11-22T20:00:00+09:00",
  doorTime: "2026-11-22T16:00:00+09:00",
  eventStatus: "https://schema.org/EventScheduled",
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  location: {
    "@type": "Place",
    name: eventInfo.venue,
  },
  organizer: {
    "@type": "Organization",
    name: eventInfo.organizer,
  },
};
---

<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="dark" />
		<title>ROOM｜{eventInfo.organizer}</title>
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body>
		<a class="skip-link" href="#content">本文へ移動</a>

		<header class="hero">
			<div class="brand-bar">
				<Image src={heroLogo} alt="" class="brand-logo" width={40} height={48} />
				<span class="brand-name">Ryuik-on</span>
			</div>
			<Image
				src={heroPhoto}
				alt=""
				class="hero-bg"
				widths={[480, 768, 1080, 1440]}
				sizes="100vw"
				loading="eager"
				fetchpriority="high"
			/>
			<div class="hero-scrim" aria-hidden="true"></div>
			<div class="hero-content">
				<p class="hero-label">ONE-MAN LIVE</p>
				<h1 class="hero-title">ROOM</h1>
				<p class="hero-meta">
					<time class="hero-date" datetime="2026-11-22">2026.11.22 SUN</time><br />
					{eventInfo.venue}<br />
					<span class="hero-times">OPEN {eventInfo.open} / START {eventInfo.start}</span>
				</p>
			</div>
		</header>

		<main id="content">
			<section aria-label="写真" class="photos">
				<h2 class="sr-only">写真</h2>
				<ul class="photo-list">
					{photos.map((photo) => (
						<li>
							<Image
								src={photo.src}
								alt={photo.alt}
								widths={[480, 768, 1080]}
								sizes="(min-width: 768px) 66vw, 100vw"
								loading="eager"
							/>
						</li>
					))}
				</ul>
			</section>

			<section aria-label="ROOMのコンセプト" class="content-section concept">
				<h2 class="sr-only">ROOMのコンセプト</h2>
				<p>
					音を鳴らしている姿。<br />
					その姿から伝わる熱は、<br class="sp-only" />必要としている誰かに届くはずです。
				</p>
			</section>

			<section aria-label="Founder's Note" class="content-section founder">
				<h2 class="eyebrow">Founder's Note</h2>
				<p>
					だから、この夜をつくります。<br />
					鳴らした音を、届くべき人へ。<br />
					それを目の当たりにすれば、自分だけじゃないと思えるかもしれません。
				</p>
			</section>

			<section aria-label="公演情報" class="content-section info">
				<h2 class="section-title">公演情報</h2>
				<dl>
					<dt>終演目安</dt>
					<dd>{eventInfo.endEstimate}</dd>
					<dt>料金</dt>
					<dd>学生 1,000円 / 一般 1,500円 / 小人 500円</dd>
					<dt>当日券</dt>
					<dd>販売あり（前売り残数がある場合のみ）</dd>
					<dt>出演者</dt>
					<dd>後日公開</dd>
					<dt>セットリスト</dt>
					<dd>後日公開</dd>
					<dt>会場</dt>
					<dd>
						<a class="venue-link" href={mapUrl} target="_blank" rel="noopener">地図を見る（Google Maps）</a>
					</dd>
				</dl>
			</section>

			<section aria-label="チケット" class="content-section ticket" id="ticket">
				<h2 class="section-title">チケット</h2>
				<p class="sale-date">前売券は <time datetime="2026-08-22">2026年8月22日（土）</time> 販売開始</p>
				<p>
					<a class="cta" href="https://teket.jp/19130/74082">チケットを購入する<span aria-hidden="true">→</span></a>
				</p>
				<p class="ticket-note">teket（外部サイト）が開きます</p>
			</section>

			<section aria-label="Instagram・公式サイトへの導線" class="content-section links">
				<h2 class="section-title">最新情報・問い合わせ</h2>
				<ul>
					<li><a href="https://www.instagram.com/ryuikeion/" target="_blank" rel="noopener">Instagram</a></li>
					<li><a href="https://ryuik-on.github.io/ryuik-on-official" target="_blank" rel="noopener">公式サイト</a></li>
					<li><span class="dim">問い合わせ先（準備中）</span></li>
				</ul>
			</section>
		</main>

		<footer>
			<p>&copy; 2026 {eventInfo.organizer}</p>
			<p><a href="#top">ページ先頭へ戻る</a></p>
		</footer>

		<a class="ticket-pill" href="#ticket">TICKET</a>

		<style is:global>
			:root {
				color-scheme: dark;
				--bg: #131313;
				--bg-deep: #000000;
				--text: #f2f2f0;
				--text-dim: #8a8a86;
				--line: #333331;
			}
			html {
				background: var(--bg);
			}
			body {
				margin: 0;
				background: var(--bg);
				color: var(--text);
				font-family: -apple-system, BlinkMacSystemFont, "Hiragino Kaku Gothic ProN", "Hiragino Sans", "Noto Sans JP", "Yu Gothic", sans-serif;
				line-height: 1.9;
			}
			a {
				color: var(--text);
			}
			a:focus-visible {
				outline: 2px solid var(--text);
				outline-offset: 3px;
			}
			::selection {
				background: var(--text);
				color: var(--bg-deep);
			}
		</style>

		<style>
			.skip-link {
				position: absolute;
				left: -9999px;
				top: 0;
				z-index: 100;
				background: var(--text);
				color: var(--bg-deep);
				padding: 10px 18px;
			}
			.skip-link:focus {
				left: 0;
			}

			.sr-only {
				position: absolute;
				width: 1px;
				height: 1px;
				padding: 0;
				margin: -1px;
				overflow: hidden;
				clip: rect(0, 0, 0, 0);
				white-space: nowrap;
				border: 0;
			}

			/* ---- Hero ---- */
			.hero {
				position: relative;
				min-height: min(100svh, 820px);
				display: flex;
				align-items: flex-end;
				overflow: hidden;
				color: var(--text);
			}
			.brand-bar {
				position: absolute;
				top: 0;
				left: 0;
				right: 0;
				z-index: 3;
				display: flex;
				align-items: center;
				gap: 10px;
				padding: 14px clamp(20px, 6vw, 64px);
				background: linear-gradient(to bottom, rgba(14, 12, 9, 0.6), rgba(14, 12, 9, 0));
			}
			.brand-bar :global(.brand-logo) {
				width: 28px;
				height: auto;
				display: block;
			}
			.brand-name {
				font-size: 0.95rem;
				font-weight: 700;
				letter-spacing: 0.03em;
			}
			.hero :global(.hero-bg) {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				object-fit: cover;
				object-position: 50% 35%;
				z-index: 0;
			}
			.hero-scrim {
				position: absolute;
				inset: 0;
				background: linear-gradient(
					to bottom,
					rgba(14, 12, 9, 0.4) 0%,
					rgba(14, 12, 9, 0.12) 30%,
					rgba(22, 19, 15, 0.72) 78%,
					var(--bg) 100%
				);
				z-index: 1;
			}
			.hero-content {
				position: relative;
				z-index: 2;
				width: 100%;
				padding: 32px clamp(20px, 6vw, 64px) clamp(40px, 8vh, 88px);
				text-align: left;
			}
			.hero-label {
				margin: 0 0 10px;
				font-size: 0.78rem;
				letter-spacing: 0.32em;
				color: var(--text-dim);
			}
			.hero-title {
				margin: 0 0 24px;
				font-size: clamp(3.2rem, 16vw, 7.5rem);
				font-weight: 700;
				letter-spacing: 0.1em;
				line-height: 1;
			}
			.hero-meta {
				margin: 0;
				font-size: 0.95rem;
				line-height: 1.9;
				color: var(--text);
				font-variant-numeric: tabular-nums;
			}
			.hero-date {
				font-size: 1.35rem;
				font-weight: 600;
				letter-spacing: 0.14em;
			}
			.hero-times {
				color: var(--text-dim);
				letter-spacing: 0.06em;
			}
			@media (min-width: 768px) {
				.hero-content {
					max-width: 900px;
				}
			}

			/* ---- 写真：非対称配置 ---- */
			.photo-list {
				list-style: none;
				margin: 0 auto;
				padding: clamp(32px, 8vw, 96px) clamp(20px, 6vw, 64px);
				max-width: 1240px;
				display: flex;
				flex-direction: column;
				gap: clamp(24px, 6vw, 88px);
			}
			.photo-list li {
				margin: 0;
			}
			.photo-list li:nth-child(1) {
				width: min(100%, 780px);
				align-self: flex-start;
			}
			.photo-list li:nth-child(2) {
				width: min(72%, 430px);
				align-self: flex-end;
			}
			.photo-list li:nth-child(3) {
				width: min(94%, 860px);
				align-self: center;
			}
			.photo-list :global(img) {
				display: block;
				width: 100%;
				height: auto;
			}

			/* ---- テキストセクション共通 ---- */
			.content-section {
				padding: clamp(56px, 12vh, 150px) clamp(24px, 6vw, 64px);
				max-width: 720px;
				margin-inline: auto;
			}
			.section-title {
				margin: 0 0 36px;
				font-size: 0.95rem;
				font-weight: 600;
				letter-spacing: 0.42em;
				color: var(--text-dim);
			}
			.eyebrow {
				margin: 0 0 24px;
				font-size: 0.75rem;
				font-weight: 600;
				letter-spacing: 0.24em;
				text-transform: uppercase;
				color: var(--text-dim);
			}

			.concept {
				text-align: center;
			}
			.concept p {
				margin: 0;
				font-size: clamp(1.1rem, 1rem + 0.9vw, 1.45rem);
				line-height: 2.4;
				letter-spacing: 0.05em;
			}
			.sp-only {
				display: none;
			}
			@media (max-width: 480px) {
				.sp-only {
					display: inline;
				}
				.concept p {
					font-size: 1rem;
					letter-spacing: 0.03em;
				}
			}

			.founder {
				max-width: 600px;
			}
			.founder p {
				margin: 0;
				line-height: 2.3;
				letter-spacing: 0.03em;
			}

			/* ---- 公演情報 ---- */
			.info dl {
				display: grid;
				grid-template-columns: 7em 1fr;
				margin: 0;
				font-variant-numeric: tabular-nums;
			}
			.info dt,
			.info dd {
				padding: 14px 0;
				border-bottom: 1px solid var(--line);
				margin: 0;
			}
			.info dt {
				color: var(--text-dim);
				font-size: 0.85rem;
				padding-top: 17px;
			}
			.venue-link {
				display: inline-block;
				font-size: 0.85rem;
				margin-top: 4px;
			}

			/* ---- チケット ---- */
			.ticket {
				text-align: center;
			}
			.sale-date {
				margin: 0 0 28px;
				letter-spacing: 0.04em;
				font-variant-numeric: tabular-nums;
			}
			.cta {
				display: inline-flex;
				align-items: center;
				gap: 12px;
				background: transparent;
				border: 1px solid var(--text);
				color: var(--text);
				text-decoration: none;
				font-weight: 600;
				letter-spacing: 0.1em;
				padding: 18px 40px;
			}
			.cta:hover {
				background: var(--text);
				color: var(--bg-deep);
			}
			.cta:focus-visible {
				outline: 2px solid var(--text);
				outline-offset: 3px;
			}
			.ticket-note {
				margin: 16px 0 0;
				font-size: 0.8rem;
				color: var(--text-dim);
			}

			/* ---- リンク ---- */
			.links ul {
				list-style: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-wrap: wrap;
				gap: 12px 32px;
			}
			.dim {
				color: var(--text-dim);
			}

			/* ---- Footer ---- */
			footer {
				border-top: 1px solid var(--line);
				padding: 40px clamp(24px, 6vw, 64px) calc(48px + env(safe-area-inset-bottom));
				text-align: center;
				font-size: 0.8rem;
				color: var(--text-dim);
			}
			footer p {
				margin: 6px 0;
			}

			/* ---- 固定TICKET導線 ---- */
			.ticket-pill {
				position: fixed;
				right: 16px;
				bottom: calc(16px + env(safe-area-inset-bottom));
				z-index: 50;
				background: var(--text);
				color: var(--bg-deep);
				text-decoration: none;
				font-size: 0.78rem;
				font-weight: 700;
				letter-spacing: 0.14em;
				padding: 13px 22px;
				box-shadow: 0 4px 18px rgba(0, 0, 0, 0.45);
			}
			.ticket-pill:hover {
				background: var(--text-dim);
			}
			.ticket-pill:focus-visible {
				outline: 2px solid var(--text);
				outline-offset: 3px;
			}
		</style>
	</body>
</html>
