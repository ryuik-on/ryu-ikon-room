---
import { Image } from "astro:assets";
import heroPhoto from "../assets/hero/hero-photo.jpg";
import heroLogo from "../assets/hero/ryuikon-logo.png";
import photo01 from "../assets/photos/photo-01.jpg";
import photo02 from "../assets/photos/photo-02.jpg";
import photo03 from "../assets/photos/photo-03.jpg";

const photos = [
  { src: photo01, alt: "マイクに向かって手を伸ばすボーカルと、それに応える観客たち" },
  { src: photo02, alt: "目を閉じてギターを弾く奏者" },
  { src: photo03, alt: "両手を上げて盛り上がる観客と、それを見守る奏者" },
];

const eventInfo = {
  organizer: "琉球大学医学部軽音部（Ryuik-on）",
  date: "2026年11月22日（日）",
  open: "16:00",
  start: "17:00",
  endEstimate: "20:00頃",
  venue: "那覇市ぶんかテンブス館 テンブスホール",
};
---

<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>ROOM｜{eventInfo.organizer}</title>
	</head>
	<body>
		<!-- Phase 4: Hero。IMG_9599（claude_room提供・部内撮影で使用可確認済み、公式サイトROOMブロックと同一素材）とRyuik-onロゴを使用。 -->
		<!-- 公式サイト（ryuik-on.github.io）のROOM告知ブロックにレイアウトを揃える。文字は画像に焼き込まず実テキストで重ねる。 -->

		<header class="hero">
			<div class="brand-bar">
				<Image src={heroLogo} alt="" class="brand-logo" width={40} height={48} />
				<span class="brand-name">Ryuik-on</span>
			</div>
			<Image
				src={heroPhoto}
				alt=""
				class="hero-bg"
				widths={[480, 768, 1080, 1440]}
				sizes="100vw"
				loading="eager"
				fetchpriority="high"
			/>
			<div class="hero-scrim" aria-hidden="true"></div>
			<div class="hero-content">
				<p class="hero-label">ONE-MAN LIVE</p>
				<h1 class="hero-title">ROOM</h1>
				<p class="hero-meta">
					{eventInfo.date}<br />
					{eventInfo.venue}<br />
					OPEN {eventInfo.open} / START {eventInfo.start}
				</p>
			</div>
		</header>

		<style>
			.hero {
				position: relative;
				min-height: 100svh;
				display: flex;
				align-items: flex-end;
				overflow: hidden;
				color: #f5f3f0;
			}
			.brand-bar {
				position: absolute;
				top: 0;
				left: 0;
				right: 0;
				z-index: 3;
				display: flex;
				align-items: center;
				gap: 10px;
				padding: 14px clamp(20px, 6vw, 64px);
				background: linear-gradient(to bottom, rgba(10, 9, 8, 0.6), rgba(10, 9, 8, 0));
			}
			.brand-bar :global(.brand-logo) {
				width: 28px;
				height: auto;
				display: block;
			}
			.brand-name {
				font-size: 0.95rem;
				font-weight: 700;
				letter-spacing: 0.03em;
			}
			.hero :global(.hero-bg) {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				object-fit: cover;
				object-position: 50% 35%;
				z-index: 0;
			}
			.hero-scrim {
				position: absolute;
				inset: 0;
				background: linear-gradient(
					to bottom,
					rgba(10, 9, 8, 0.35) 0%,
					rgba(10, 9, 8, 0.15) 30%,
					rgba(10, 9, 8, 0.7) 78%,
					rgba(10, 9, 8, 0.92) 100%
				);
				z-index: 1;
			}
			.hero-content {
				position: relative;
				z-index: 2;
				width: 100%;
				padding: 32px clamp(20px, 6vw, 64px) clamp(32px, 6vh, 72px);
				text-align: left;
			}
			.hero-label {
				margin: 0 0 8px;
				font-size: 0.8rem;
				letter-spacing: 0.28em;
				text-transform: uppercase;
				color: #d8d2c9;
			}
			.hero-title {
				margin: 0 0 20px;
				font-size: clamp(3rem, 16vw, 6rem);
				font-weight: 700;
				letter-spacing: 0.04em;
				line-height: 1;
			}
			.hero-meta {
				margin: 0;
				font-size: 0.95rem;
				line-height: 1.8;
				color: #ece7de;
			}
			@media (min-width: 768px) {
				.hero-content { max-width: 720px; }
			}

			.sr-only {
				position: absolute;
				width: 1px;
				height: 1px;
				padding: 0;
				margin: -1px;
				overflow: hidden;
				clip: rect(0, 0, 0, 0);
				white-space: nowrap;
				border: 0;
			}

			.photos {
				padding: 0;
			}
			.photo-list {
				list-style: none;
				margin: 0;
				padding: 0;
				display: grid;
				grid-template-columns: 1fr;
				gap: 2px;
			}
			.photo-list :global(img) {
				display: block;
				width: 100%;
				height: auto;
			}
			@media (min-width: 768px) {
				.photo-list { grid-template-columns: repeat(3, 1fr); }
			}
		</style>

		<main>
			<section aria-label="写真または映像" class="photos">
				<h2 class="sr-only">写真</h2>
				<ul class="photo-list">
					{photos.map((photo) => (
						<li>
							<Image
								src={photo.src}
								alt={photo.alt}
								widths={[480, 768, 1080]}
								sizes="(min-width: 768px) 33vw, 100vw"
								loading="lazy"
							/>
						</li>
					))}
				</ul>
			</section>

			<section aria-label="ROOMのコンセプト">
				<h2>ROOMのコンセプト（暫定・修正予定）</h2>
				<p>
					奏者が、それぞれの日常で<br />
					「これでいいんだろうか」と迷いながらも必死に音を鳴らし、<br />
					その熱を、必要としている人へまっすぐ届ける。
				</p>
			</section>

			<section aria-label="Founder's Note">
				<h2>Founder's Note（下書き・未確定）</h2>
				<p>
					だから、この夜をつくります。<br />
					必死に鳴らした音を、<br />
					届くべき人へ、まっすぐ渡すために。<br />
					立ち止まって聴いてくれたら、それだけで、<br />
					自分だけじゃないと思えるかもしれません。
				</p>
				<p>（v1掲載文をそのまま暫定表示。最終文章は再検討中）</p>
			</section>

			<section aria-label="公演情報">
				<h2>公演情報</h2>
				<dl>
					<dt>公演名</dt>
					<dd>ROOM</dd>
					<dt>主催</dt>
					<dd>{eventInfo.organizer}</dd>
					<dt>日程</dt>
					<dd>{eventInfo.date}</dd>
					<dt>OPEN</dt>
					<dd>{eventInfo.open}</dd>
					<dt>START</dt>
					<dd>{eventInfo.start}</dd>
					<dt>終演目安</dt>
					<dd>{eventInfo.endEstimate}</dd>
					<dt>会場</dt>
					<dd>{eventInfo.venue}</dd>
					<dt>料金</dt>
					<dd>学生 1,000円 / 一般 1,500円 / 小人 500円</dd>
					<dt>当日券</dt>
					<dd>販売あり（前売り残数がある場合のみ）</dd>
					<dt>出演者</dt>
					<dd>後日公開</dd>
					<dt>セットリスト</dt>
					<dd>後日公開</dd>
				</dl>
			</section>

			<section aria-label="チケット導線">
				<h2>チケット</h2>
				<p>販売開始：2026年8月22日〜</p>
				<p>
					<a href="https://teket.jp/19130/74082">チケットを購入する（teket）</a>
				</p>
				<p>（8月22日の販売開始まではページ未公開の可能性あり。売切/当日券の表示方針はPhase 8で検討）</p>
			</section>

			<section aria-label="Instagram・公式サイトへの導線">
				<h2>最新情報・問い合わせ</h2>
				<ul>
					<li><a href="https://www.instagram.com/ryuikeion/">Instagram</a></li>
					<li><a href="https://ryuik-on.github.io/ryuik-on-official">公式サイト</a></li>
					<li>問い合わせ先（準備中）</li>
				</ul>
			</section>
		</main>

		<footer>
			<p>{eventInfo.organizer}</p>
			<p>&copy; 2026 {eventInfo.organizer}</p>
			<p><a href="#top">ページ先頭へ戻る</a></p>
		</footer>
	</body>
</html>
